erticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="588" width="200" height="96" as="geometry"/></mxCell><mxCell id="c55" value="IntersectionObserver 登録&lt;br&gt;画面内なら即ビルド" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1410" y="588" width="190" height="96" as="geometry"/></mxCell><mxCell id="c56" value="—" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1610" y="588" width="200" height="96" as="geometry"/></mxCell><mxCell id="c57" value="6 createComponent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="694" width="110" height="96" as="geometry"/></mxCell><mxCell id="c58" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="694" width="160" height="96" as="geometry"/></mxCell><mxCell id="c59" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1070" y="694" width="120" height="96" as="geometry"/></mxCell><mxCell id="c60" value="なし(data$ は未購読)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="694" width="200" height="96" as="geometry"/></mxCell><mxCell id="c61" value="コンポーネントの DOM が生まれる&lt;br&gt;ComponentCreateEvent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1410" y="694" width="190" height="96" as="geometry"/></mxCell><mxCell id="c62" value="mapping 無し: そのコンポーネント&lt;br&gt;だけ描かれない(本番は無言)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1610" y="694" width="200" height="96" as="geometry"/></mxCell><mxCell id="c63" value="7 data$ 購読" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="800" width="110" height="96" as="geometry"/></mxCell><mxCell id="c64" value="同梱済みなら なし&lt;br&gt;不足分だけ cms/components" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="800" width="160" height="96" as="geometry"/></mxCell><mxCell id="c65" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1070" y="800" width="120" height="96" as="geometry"/></mxCell><mxCell id="c66" value="loaderState を見て dispatch 判定&lt;br&gt;応答を components[uid] に格納" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="800" width="200" height="96" as="geometry"/></mxCell><mxCell id="c67" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1410" y="800" width="190" height="96" as="geometry"/></mxCell><mxCell id="c68" value="uid が無い: null → そのコンポーネント&lt;br&gt;だけ空。言語変更/ログインで要求破棄" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1610" y="800" width="200" height="96" as="geometry"/></mxCell><mxCell id="c69" value="8 async → 描画" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="906" width="110" height="96" as="geometry"/></mxCell><mxCell id="c70" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="906" width="160" height="96" as="geometry"/></mxCell><mxCell id="c71" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1070" y="906" width="120" height="96" as="geometry"/></mxCell><mxCell id="c72" value="select で現在値を読む" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="906" width="200" height="96" as="geometry"/></mxCell><mxCell id="c73" value="markForCheck → 次の変更検知で描画&lt;br&gt;pending-- → cx-pending 解除" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1410" y="906" width="190" height="96" as="geometry"/></mxCell><mxCell id="c74" value="—" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1610" y="906" width="200" height="96" as="geometry"/></mxCell><mxCell id="c75" value="読み方: 橙 = 通信が起きる(OCC か静的ファイル)、青 = NgRx ストアを書く/読む、緑 = DOM が変わる、赤 = 失敗したときに影響する範囲。&lt;br&gt;cms/pages の応答から最初の描画まで OCC への通信は 0 本。cms/components が飛ぶのは「購読した時点でストアに無い uid」とナビゲーションの子項目だけ。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="1024" width="1030" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="13 API の形 → State の形: 3 層の作り変え" id="13 API の形 → State の形: 3 層の作り変え"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="cms/pages の JSON(入れ子の木)が Normalizer → Effect → Reducer の 3 層を通って cms ステート(3 テーブル)になるまで(左)と、State で見える違いごとに「どの層が作るか」「変えたいときの入口」(右)。15 章" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1760" height="30" as="geometry"/></mxCell><mxCell id="c3" value="A. 3 層の作り変え(上から順に通る)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="720" height="900" as="geometry"/></mxCell><mxCell id="c4" value="入力: cms/pages の JSON&lt;br&gt;Occ.CMSPage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="164" width="250" height="120" as="geometry"/></mxCell><mxCell id="c5" value="入れ子の木。スロットの中にコンポーネント本体が埋まっている&lt;br&gt;{ uid, typeCode, label, template, ...,&lt;br&gt;  contentSlots.contentSlot[ { position, properties,&lt;br&gt;    components.component[ { uid, typeCode, name, properties, ...本体 } ] } ] }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="164" width="440" height="120" as="geometry"/></mxCell><mxCell id="c6" value="層 1 Normalizer&lt;br&gt;OccCmsPageNormalizer.convert&lt;br&gt;(DI: CMS_PAGE_NORMALIZER, multi)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="294" width="250" height="120" as="geometry"/></mxCell><mxCell id="c7" value="ConverterService.pipeable がアダプタの中で適用。出力は {page, components} の 2 つ&lt;br&gt;・normalizePageData: uid→pageId, typeCode→type, robotTag→robots[]&lt;br&gt;・normalizePageSlotData: contentSlot[] → slots[position] の辞書&lt;br&gt;・normalizePageComponentData: 各本体を {uid,typeCode,flexType,properties} に削って slots に&lt;br&gt;・normalizeComponentData: 本体全体を components[] に。properties は undefined に" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="294" width="440" height="120" as="geometry"/></mxCell><mxCell id="c8" value="層 2 Effect&lt;br&gt;PageEffects.loadPageData$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="424" width="250" height="120" as="geometry"/></mxCell><mxCell id="c9" value="1 つの応答を 2〜3 個のアクションに分割して一度に dispatch&lt;br&gt;・CmsGetComponentFromPage( components.map(c =&amp;gt; {component: c, pageContext}) )&lt;br&gt;・LoadCmsPageDataSuccess( pageContext, page )&lt;br&gt;・(CmsSetPageSuccessIndex: label と id が違うときだけ)&lt;br&gt;pageContext は API に無い情報。ここで添えられる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="424" width="440" height="120" as="geometry"/></mxCell><mxCell id="c10" value="層 3 Reducer&lt;br&gt;entityReducer / loaderReducer&lt;br&gt;+ cms の各 reducer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="554" width="250" height="120" as="geometry"/></mxCell><mxCell id="c11" value="・entityReducer: entityId と payload が両方配列なら 1 件ずつ割って entities[id] に&lt;br&gt;・loaderReducer: {loading, error, success, value} のフラグを包む&lt;br&gt;・components.reducer: {component, pageContext[serializePageContext(ctx,true)]}&lt;br&gt;・page-data.reducer: entities[pageId] = page(Normalizer 出力そのまま)&lt;br&gt;・page-index.reducer: entities[label|code] = pageId(索引だけ)&lt;br&gt;・navigation-entry-item.reducer: { uid + &amp;#x27;_AbstractCMSComponent&amp;#x27;: 本体 } の辞書" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="554" width="440" height="120" as="geometry"/></mxCell><mxCell id="c12" value="出力: cms ステート&lt;br&gt;(Redux DevTools で見える形)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="684" width="250" height="120" as="geometry"/></mxCell><mxCell id="c13" value="cms&lt;br&gt;├ page.pageData.entities[pageId]   ← 配置(slots[pos].components = 4 項目)&lt;br&gt;├ page.index.{content|product|category|catalog}.entities[id] = pageId&lt;br&gt;├ components.entities[uid] = { component, pageContext: {&amp;quot;ContentPage&amp;quot;: {...}} }&lt;br&gt;└ navigation.entities[nodeId] = { uid_AbstractCMSComponent: {...} }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="684" width="440" height="120" as="geometry"/></mxCell><mxCell id="c14" value="B. State で見える違い: どの層が作るか / 変えたいときの入口" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#d79b00;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="800" y="70" width="1100" height="900" as="geometry"/></mxCell><mxCell id="c15" value="State で見える違い" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="200" height="44" as="geometry"/></mxCell><mxCell id="c16" value="API 側" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1028" y="110" width="160" height="44" as="geometry"/></mxCell><mxCell id="c17" value="State 側" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1196" y="110" width="190" height="44" as="geometry"/></mxCell><mxCell id="c18" value="作っている場所" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1394" y="110" width="250" height="44" as="geometry"/></mxCell><mxCell id="c19" value="変えたいときの入口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1652" y="110" width="250" height="44" as="geometry"/></mxCell><mxCell id="c20" value="ページとコンポーネントが&lt;br&gt;別テーブル" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="162" width="200" height="76" as="geometry"/></mxCell><mxCell id="c21" value="スロットの中に本体が入れ子" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1028" y="162" width="160" height="76" as="geometry"/></mxCell><mxCell id="c22" value="page.pageData と components" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1196" y="162" width="190" height="76" as="geometry"/></mxCell><mxCell id="c23" value="層 1 normalizePageComponentData&lt;br&gt;+ normalizeComponentData" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1394" y="162" width="250" height="76" as="geometry"/></mxCell><mxCell id="c24" value="CMS_PAGE_NORMALIZER に&lt;br&gt;自作 converter を multi 追加" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1652" y="162" width="250" height="76" as="geometry"/></mxCell><mxCell id="c25" value="スロットが辞書 /&lt;br&gt;中のコンポーネントが 4 項目" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="246" width="200" height="76" as="geometry"/></mxCell><mxCell id="c26" value="contentSlot[] 配列&lt;br&gt;本体の全属性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1028" y="246" width="160" height="76" as="geometry"/></mxCell><mxCell id="c27" value="slots[position]&lt;br&gt;{uid,typeCode,flexType,properties}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1196" y="246" width="190" height="76" as="geometry"/></mxCell><mxCell id="c28" value="層 1 normalizePageSlotData&lt;br&gt;:120-125" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1394" y="246" width="250" height="76" as="geometry"/></mxCell><mxCell id="c29" value="同上" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1652" y="246" width="250" height="76" as="geometry"/></mxCell><mxCell id="c30" value="本体に properties が無い" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="330" width="200" height="76" as="geometry"/></mxCell><mxCell id="c31" value="有る" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1028" y="330" width="160" height="76" as="geometry"/></mxCell><mxCell id="c32" value="undefined" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1196" y="330" width="190" height="76" as="geometry"/></mxCell><mxCell id="c33" value="層 1 normalizeComponentData:185&lt;br&gt;(意図的: コメントあり)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1394" y="330" width="250" height="76" as="geometry"/></mxCell><mxCell id="c34" value="同上。ただし既定の後に動くので&lt;br&gt;消された後。トップレベル属性を使う" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1652" y="330" width="250" height="76" as="geometry"/></mxCell><mxCell id="c35" value="flexType が全件に有る /&lt;br&gt;pageId・type・robots[] の名前" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="414" width="200" height="76" as="geometry"/></mxCell><mxCell id="c36" value="CMSFlexComponent だけ /&lt;br&gt;uid・typeCode・robotTag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;ve