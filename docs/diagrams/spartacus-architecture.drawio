;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="688" width="100" height="60" as="geometry"/></mxCell><mxCell id="c60" value="users/{userId}/campaignEntries/{code}(例)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="806" y="688" width="280" height="60" as="geometry"/></mxCell><mxCell id="c61" value="新 ItemType" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1092" y="688" width="170" height="60" as="geometry"/></mxCell><mxCell id="c62" value="新コントローラ + WsDTO(12.4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1268" y="688" width="170" height="60" as="geometry"/></mxCell><mxCell id="c63" value="campaignCode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1444" y="688" width="160" height="60" as="geometry"/></mxCell><mxCell id="c64" value="ItemType 名は SAP Commerce 標準型システムの一般知識で、本リポジトリでは検証不能(Backoffice の型検索で確認)。URL パターンは Spartacus の default-occ-*-config.ts 45 ファイルから収集。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="758" width="900" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="12 cms/pages 応答 → async パイプまでの 8 段階" id="12 cms/pages 応答 → async パイプまでの 8 段階"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="cms/pages の応答が届いてから、コンポーネントの data$ | async が値を出すまでの 8 段階(左)と、段階ごとに何が起きるか・失敗したときの範囲(右)。4 章" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="30" as="geometry"/></mxCell><mxCell id="c3" value="A. 8 段階: 何をするか(上から順に実行される)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="680" height="1010" as="geometry"/></mxCell><mxCell id="c4" value="1. 正規化&lt;br&gt;OccCmsPageNormalizer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="164" width="250" height="96" as="geometry"/></mxCell><mxCell id="c5" value="1 つの JSON から 2 つの形を作る&lt;br&gt;・page.slots[位置].components = {uid, typeCode, flexType, properties}&lt;br&gt;・components = コンポーネント本体(properties は捨てる)&lt;br&gt;flexType = typeCode(CMSFlexComponent だけ flexType 属性)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="164" width="390" height="96" as="geometry"/></mxCell><mxCell id="c6" value="2. ストア格納&lt;br&gt;PageEffects → reducer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="250" height="96" as="geometry"/></mxCell><mxCell id="c7" value="CmsGetComponentFromPage(同梱全件)と LoadCmsPageDataSuccess を一度に dispatch&lt;br&gt;components[uid].pageContext[&amp;#x27;ContentPage&amp;#x27;] = success&lt;br&gt;ページ index[pageId] = success → ガードが待っていた hasPage が通る" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="270" width="390" height="96" as="geometry"/></mxCell><mxCell id="c8" value="3. ガード(まだ描画しない)&lt;br&gt;CmsPageGuardService.canActivatePage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="376" width="250" height="96" as="geometry"/></mxCell><mxCell id="c9" value="ページ内の flexType 集合 → determineMappings(遅延モジュールの import())&lt;br&gt;→ guards 実行 → i18n チャンク読込 → childRoutes があれば再ナビゲーション&lt;br&gt;→ true で Router が PageLayoutComponent を生成、ROUTER_NAVIGATED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="376" width="390" height="96" as="geometry"/></mxCell><mxCell id="c10" value="4. レイアウト → スロット&lt;br&gt;PageLayoutComponent / PageSlotComponent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="482" width="250" height="96" as="geometry"/></mxCell><mxCell id="c11" value="LayoutConfig.layoutSlots[template].slots ∩ 応答の slots → &amp;lt;cx-page-slot&amp;gt; を並べる&lt;br&gt;各スロットが getContentSlot(position) で components 配列を取る&lt;br&gt;pending = 件数 → cx-pending クラス" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="482" width="390" height="96" as="geometry"/></mxCell><mxCell id="c12" value="5. 遅延判定とアウトレット&lt;br&gt;OutletDirective + DeferLoaderService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="588" width="250" height="96" as="geometry"/></mxCell><mxCell id="c13" value="cxOutletDefer: INSTANT なら即、DEFER なら IntersectionObserver で画面に入るまで&lt;br&gt;ラッパーすら作らない(既定は INSTANT)&lt;br&gt;cxOutlet=flexType に差し替えテンプレートがあればそちらを描く(1.7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="588" width="390" height="96" as="geometry"/></mxCell><mxCell id="c14" value="6. ラッパーが createComponent&lt;br&gt;ComponentWrapperDirective" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="694" width="250" height="96" as="geometry"/></mxCell><mxCell id="c15" value="getMapping(flexType) → 無ければ何もしない(dev 警告のみ)&lt;br&gt;子 Injector に CmsComponentData{uid, data$} と mapping.providers を provide&lt;br&gt;→ ViewContainerRef.createComponent → constructor で注入 → ComponentCreateEvent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="694" width="390" height="96" as="geometry"/></mxCell><mxCell id="c16" value="7. data$ を購読(ここで初めて動く)&lt;br&gt;CmsService.getComponentData" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="250" height="96" as="geometry"/></mxCell><mxCell id="c17" value="ストアに uid × context があれば同期で値 → HTTP なし&lt;br&gt;無ければ LoadCmsComponent → 同一マクロタスク分をまとめて&lt;br&gt;GET cms/components?componentIds=…(50 件/回、商品ページなら productCode=)&lt;br&gt;ナビゲーションの子項目も同じ getList を通る(別エフェクト)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="800" width="390" height="96" as="geometry"/></mxCell><mxCell id="c18" value="8. async パイプ → 変更検知 → 描画&lt;br&gt;Angular AsyncPipe(pure: false)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="906" width="250" height="96" as="geometry"/></mxCell><mxCell id="c19" value="最初の transform で subscribe(= 7 が動く)。同期で来ればその場で値&lt;br&gt;値が来るたび markForCheck → OnPush を次の変更検知で再描画&lt;br&gt;無い間は null → *ngIf が描かない。(loaded) で pending-- → cx-pending 解除" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="906" width="390" height="96" as="geometry"/></mxCell><mxCell id="c20" value="B. 段階ごとに何が起きるか: 通信 / ストア / DOM / 失敗の範囲" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#d79b00;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="760" y="70" width="1070" height="1010" as="geometry"/></mxCell><mxCell id="c21" value="段階" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="110" width="110" height="44" as="geometry"/></mxCell><mxCell id="c22" value="OCC への通信" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="110" width="160" height="44" as="geometry"/></mxCell><mxCell id="c23" value="静的ファイル" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1070" y="110" width="120" height="44" as="geometry"/></mxCell><mxCell id="c24" value="NgRx ストア" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="110" width="200" height="44" as="geometry"/></mxCell><mxCell id="c25" value="DOM / 変更検知" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1410" y="110" width="190" height="44" as="geometry"/></mxCell><mxCell id="c26" value="失敗したときの範囲" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1610" y="110" width="200" height="44" as="geometry"/></mxCell><mxCell id="c27" value="1 正規化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="164" width="110" height="96" as="geometry"/></mxCell><mxCell id="c28" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="164" width="160" height="96" as="geometry"/></mxCell><mxCell id="c29" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1070" y="164" width="120" height="96" as="geometry"/></mxCell><mxCell id="c30" value="まだ触らない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="164" width="200" height="96" as="geometry"/></mxCell><mxCell id="c31" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1410" y="164" width="190" height="96" as="geometry"/></mxCell><mxCell id="c32" value="応答が壊れていれば&lt;br&gt;LoadCmsPageDataFail → 404 ページ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1610" y="164" width="200" height="96" as="geometry"/></mxCell><mxCell id="c33" value="2 ストア格納" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="270" width="110" height="96" as="geometry"/></mxCell><mxCell id="c34" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="270" width="160" height="96" as="geometry"/></mxCell><mxCell id="c35" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1070" y="270" width="120" height="96" as="geometry"/></mxCell><mxCell id="c36" value="components[uid] と page.index に&lt;br&gt;success を書く" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="270" width="200" height="96" as="geometry"/></mxCell><mxCell id="c37" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1410" y="270" width="190" height="96" as="geometry"/></mxCell><mxCell id="c38" value="—" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1610" y="270" width="200" height="96" as="geometry"/></mxCell><mxCell id="c39" value="3 ガード" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="376" width="110" height="96" as="geometry"/></mxCell><mxCell id="c40" value="なし&lt;br&gt;(guards の実装次第)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="376" width="160" height="96" as="geometry"/></mxCell><mxCell id="c41" value="遅延モジュールの JS&lt;br&gt;翻訳 JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1070" y="376" width="120" height="96" as="geometry"/></mxCell><mxCell id="c42" value="読むだけ&lt;br&gt;(flexType の集合)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="376" width="200" height="96" as="geometry"/></mxCell><mxCell id="c43" value="なし&lt;br&gt;(ルート設定の差し替えあり)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1410" y="376" width="190" height="96" as="geometry"/></mxCell><mxCell id="c44" value="ページ全体: 遷移中止&lt;br&gt;(guards false / import 失敗)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1610" y="376" width="200" height="96" as="geometry"/></mxCell><mxCell id="c45" value="4 レイアウト→スロット" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="482" width="110" height="96" as="geometry"/></mxCell><mxCell id="c46" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="482" width="160" height="96" as="geometry"/></mxCell><mxCell id="c47" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1070" y="482" width="120" height="96" as="geometry"/></mxCell><mxCell id="c48" value="読むだけ&lt;br&gt;(page.template, slots)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="482" width="200" height="96" as="geometry"/></mxCell><mxCell id="c49" value="&amp;lt;cx-page-slot&amp;gt; が並ぶ&lt;br&gt;cx-pending 付き" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1410" y="482" width="190" height="96" as="geometry"/></mxCell><mxCell id="c50" value="LayoutConfig に無いスロットは&lt;br&gt;描かれない(dev 警告)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1610" y="482" width="200" height="96" as="geometry"/></mxCell><mxCell id="c51" value="5 遅延判定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="588" width="110" height="96" as="geometry"/></mxCell><mxCell id="c52" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="588" width="160" height="96" as="geometry"/></mxCell><mxCell id="c53" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1070" y="588" width="120" height="96" as="geometry"/></mxCell><mxCell id="c54" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="588" width="200" height="96" as="geometry"/></mxCell><mxCell id="c55" value="IntersectionObserver 登録&lt;br&gt;画面内なら即ビルド" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1410" y="588" width="190" height="96" as="geometry"/></mxCell><mxCell id="c56" value="—" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1610" y="588" width="200" height="96" as="geometry"/></mxCell><mxCell id="c57" value="6 createComponent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="694" width="110" height="96" as="geometry"/></mxCell><mxCell id="c58" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="694" width="160" height="96" as="geometry"/></mxCell><mxCell id="c59" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1070" y="694" width="120" height="96" as="geometry"/></mxCell><mxCell id="c60" value="なし(data$ は未購読)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="694" width="200" height="96" as="geometry"/></mxCell><mxCell id="c61" value="コンポーネントの DOM が生まれる&lt;br&gt;ComponentCreateEvent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1410" y="694" width="190" height="96" as="geometry"/></mxCell><mxCell id="c62" value="mapping 無し: そのコンポーネント&lt;br&gt;だけ描かれない(本番は無言)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1610" y="694" width="200" height="96" as="geometry"/></mxCell><mxCell id="c63" value="7 data$ 購読" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="800" width="110" height="96" as="geometry"/></mxCell><mxCell id="c64" value="同梱済みなら なし&lt;br&gt;不足分だけ cms/components" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="800" width="160" height="96" as="geometry"/></mxCell><mxCell id="c65" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1070" y="800" width="120" height="96" as="geometry"/></mxCell><mxCell id="c66" value="loaderState を見て dispatch 判定&lt;br&gt;応答を components[uid] に格納" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="800" width="200" height="96" as="geometry"/></mxCell><mxCell id="c67" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1410" y="800" width="190" height="96" as="geometry"/></mxCell><mxCell id="c68" value="uid が無い: null → そのコンポーネント&lt;br&gt;だけ空。言語変更/ログインで要求破棄" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1610" y="800" width="200" height="96" as="geometry"/></mxCell><mxCell id="c69" value="8 async → 描画" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="906" width="110" height="96" as="geometry"/></mxCell><mxCell id="c70" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="906" width="160" height="96" as="geometry"/></mxCell><mxCell id="c71" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1070" y="906" width="120" height="96" as="geometry"/></mxCell><mxCell id="c72" value="select で現在値を読む" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="906" width="200" height="96" as="geometry"/></mxCell><mxCell id="c73" value="markForCheck → 次の変更検知で描画&lt;br&gt;pending-- → cx-pending 解除" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1410" y="906" width="190" height="96" as="geometry"/></mxCell><mxCell id="c74" value="—" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1610" y="906" width="200" height="96" as="geometry"/></mxCell><mxCell id="c75" value="読み方: 橙 = 通信が起きる(OCC か静的ファイル)、青 = NgRx ストアを書く/読む、緑 = DOM が変わる、赤 = 失敗したときに影響する範囲。&lt;br&gt;cms/pages の応答から最初の描画まで OCC への通信は 0 本。cms/components が飛ぶのは「購読した時点でストアに無い uid」とナビゲーションの子項目だけ。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="1024" width="1030" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="13 API の形 → State の形: 3 層の作り変え" id="13 API の形 → State の形: 3 層の作り変え"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="cms/pages の JSON(入れ子の木)が Normalizer → Effect → Reducer の 3 層を通って cms ステート(3 テーブル)になるまで(左)と、State で見える違いごとに「どの層が作るか」「変えたいときの入口」(右)。5 章" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1760" height="30" as="geometry"/></mxCell><mxCell id="c3" value="A. 3 層の作り変え(上から順に通る)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="720" height="900" as="geometry"/></mxCell><mxCell id="c4" value="入力: cms/pages の JSON&lt;br&gt;Occ.CMSPage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="164" width="250" height="120" as="geometry"/></mxCell><mxCell id="c5" value="入れ子の木。スロットの中にコンポーネント本体が埋まっている&lt;br&gt;{ uid, typeCode, label, template, ...,&lt;br&gt;  contentSlots.contentSlot[ { position, properties,&lt;br&gt;    components.component[ { uid, typeCode, name, properties, ...本体 } ] } ] }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="164" width="440" height="120" as="geometry"/></mxCell><mxCell id="c6" value="層 1 Normalizer&lt;br&gt;OccCmsPageNormalizer.convert&lt;br&gt;(DI: CMS_PAGE_NORMALIZER, multi)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="294" width="250" height="120" as="geometry"/></mxCell><mxCell id="c7" value="ConverterService.pipeable がアダプタの中で適用。出力は {page, components} の 2 つ&lt;br&gt;・normalizePageData: uid→pageId, typeCode→type, robotTag→robots[]&lt;br&gt;・normalizePageSlotData: contentSlot[] → slots[position] の辞書&lt;br&gt;・normalizePageComponentData: 各本体を {uid,typeCode,flexType,properties} に削って slots に&lt;br&gt;・normalizeComponentData: 本体全体を components[] に。properties は undefined に" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="294" width="440" height="120" as="geometry"/></mxCell><mxCell id="c8" value="層 2 Effect&lt;br&gt;PageEffects.loadPageData$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="424" width="250" height="120" as="geometry"/></mxCell><mxCell id="c9" value="1 つの応答を 2〜3 個のアクションに分割して一度に dispatch&lt;br&gt;・CmsGetComponentFromPage( components.map(c =&amp;gt; {component: c, pageContext}) )&lt;br&gt;・LoadCmsPageDataSuccess( pageContext, page )&lt;br&gt;・(CmsSetPageSuccessIndex: label と id が違うときだけ)&lt;br&gt;pageContext は API に無い情報。ここで添えられる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="424" width="440" height="120" as="geometry"/></mxCell><mxCell id="c10" value="層 3 Reducer&lt;br&gt;entityReducer / loaderReducer&lt;br&gt;+ cms の各 reducer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="554" width="250" height="120" as="geometry"/></mxCell><mxCell id="c11" value="・entityReducer: entityId と payload が両方配列なら 1 件ずつ割って entities[id] に&lt;br&gt;・loaderReducer: {loading, error, success, value} のフラグを包む&lt;br&gt;・components.reducer: {component, pageContext[serializePageContext(ctx,true)]}&lt;br&gt;・page-data.reducer: entities[pageId] = page(Normalizer 出力そのまま)&lt;br&gt;・page-index.reducer: entities[label|code] = pageId(索引だけ)&lt;br&gt;・navigation-entry-item.reducer: { uid + &amp;#x27;_AbstractCMSComponent&amp;#x27;: 本体 } の辞書" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="554" width="440" height="120" as="geometry"/></mxCell><mxCell id="c12" value="出力: cms ステート&lt;br&gt;(Redux DevTools で見える形)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="684" width="250" height="120" as="geometry"/></mxCell><mxCell id="c13" value="cms&lt;br&gt;├ page.pageData.entities[pageId]   ← 配置(slots[pos].components = 4 項目)&lt;br&gt;├ page.index.{content|product|category|catalog}.entities[id] = pageId&lt;br&gt;├ components.entities[uid] = { component, pageContext: {&amp;quot;ContentPage&amp;quot;: {...}} }&lt;br&gt;└ navigation.entities[nodeId] = { uid_AbstractCMSComponent: {...} }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="684" width="440" height="120" as="geometry"/></mxCell><mxCell id="c14" value="B. State で見える違い: どの層が作るか / 変えたいときの入口" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#d79b00;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="800" y="70" width="1100" height="900" as="geometry"/></mxCell><mxCell id="c15" value="State で見える違い" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="200" height="44" as="geometry"/></mxCell><mxCell id="c16" value="API 側" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1028" y="110" width="160" height="44" as="geometry"/></mxCell><mxCell id="c17" value="State 側" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1196" y="110" width="190" height="44" as="geometry"/></mxCell><mxCell id="c18" value="作っている場所" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1394" y="110" width="250" height="44" as="geometry"/></mxCell><mxCell id="c19" value="変えたいときの入口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1652" y="110" width="250" height="44" as="geometry"/></mxCell><mxCell id="c20" value="ページとコンポーネントが&lt;br&gt;別テーブル" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="162" width="200" height="76" as="geometry"/></mxCell><mxCell id="c21" value="スロットの中に本体が入れ子" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1028" y="162" width="160" height="76" as="geometry"/></mxCell><mxCell id="c22" value="page.pageData と components" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1196" y="162" width="190" height="76" as="geometry"/></mxCell><mxCell id="c23" value="層 1 normalizePageComponentData&lt;br&gt;+ normalizeComponentData" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1394" y="162" width="250" height="76" as="geometry"/></mxCell><mxCell id="c24" value="CMS_PAGE_NORMALIZER に&lt;br&gt;自作 converter を multi 追加" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1652" y="162" width="250" height="76" as="geometry"/></mxCell><mxCell id="c25" value="スロットが辞書 /&lt;br&gt;中のコンポーネントが 4 項目" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="246" width="200" height="76" as="geometry"/></mxCell><mxCell id="c26" value="contentSlot[] 配列&lt;br&gt;本体の全属性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1028" y="246" width="160" height="76" as="geometry"/></mxCell><mxCell id="c27" value="slots[position]&lt;br&gt;{uid,typeCode,flexType,properties}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1196" y="246" width="190" height="76" as="geometry"/></mxCell><mxCell id="c28" value="層 1 normalizePageSlotData&lt;br&gt;:120-125" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1394" y="246" width="250" height="76" as="geometry"/></mxCell><mxCell id="c29" value="同上" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1652" y="246" width="250" height="76" as="geometry"/></mxCell><mxCell id="c30" value="本体に properties が無い" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="330" width="200" height="76" as="geometry"/></mxCell><mxCell id="c31" value="有る" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1028" y="330" width="160" height="76" as="geometry"/></mxCell><mxCell id="c32" value="undefined" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1196" y="330" width="190" height="76" as="geometry"/></mxCell><mxCell id="c33" value="層 1 normalizeComponentData:185&lt;br&gt;(意図的: コメントあり)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1394" y="330" width="250" height="76" as="geometry"/></mxCell><mxCell id="c34" value="同上。ただし既定の後に動くので&lt;br&gt;消された後。トップレベル属性を使う" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1652" y="330" width="250" height="76" as="geometry"/></mxCell><mxCell id="c35" value="flexType が全件に有る /&lt;br&gt;pageId・type・robots[] の名前" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="414" width="200" height="76" as="geometry"/></mxCell><mxCell id="c36" value="CMSFlexComponent だけ /&lt;br&gt;uid・typeCode・robotTag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1028" y="414" width="160" height="76" as="geometry"/></mxCell><mxCell id="c37" value="全コンポーネント /&lt;br&gt;pageId・type・robots[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1196" y="414" width="190" height="76" as="geometry"/></mxCell><mxCell id="c38" value="層 1 getFlexTypeFromComponent&lt;br&gt;normalizePageData / normalizeRobots" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1394" y="414" width="250" height="76" as="geometry"/></mxCell><mxCell id="c39" value="同上" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1652" y="414" width="250" height="76" as="geometry"/></mxCell><mxCell id="c40" value="pageContext が付いている" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="498" width="200" height="76" as="geometry"/></mxCell><mxCell id="c41" value="無い" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1028" y="498" width="160" height="76" as="geometry"/></mxCell><mxCell id="c42" value="pageContext[&amp;quot;ContentPage&amp;quot;]&lt;br&gt;pageContext[&amp;quot;ProductPage-&amp;lt;code&amp;gt;&amp;quot;]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1196" y="498" width="190" height="76" as="geometry"/></mxCell><mxCell id="c43" value="層 2 PageEffects で添付&lt;br&gt;層 3 components.reducer で形に" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1394" y="498" width="250" height="76" as="geometry"/></mxCell><mxCell id="c44" value="変えない(キャッシュ共有の鍵)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1652" y="498" width="250" height="76" as="geometry"/></mxCell><mxCell id="c45" value="loading/success/error/value" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="582" width="200" height="76" as="geometry"/></mxCell><mxCell id="c46" value="無い" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1028" y="582" width="160" height="76" as="geometry"/></mxCell><mxCell id="c47" value="有る" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1196" y="582" width="190" height="76" as="geometry"/></mxCell><mxCell id="c48" value="層 3 loaderReducer&lt;br&gt;(value = componentExistsReducer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1394" y="582" width="250" height="76" as="geometry"/></mxCell><mxCell id="c49" value="変えない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1652" y="582" width="250" height="76" as="geometry"/></mxCell><mxCell id="c50" value="entities[uid] / entities[pageId]&lt;br&gt;の辞書" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="666" width="200" height="76" as="geometry"/></mxCell><mxCell id="c51" value="配列" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1028" y="666" width="160" height="76" as="geometry"/></mxCell><mxCell id="c52" value="辞書" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1196" y="666" width="190" height="76" as="geometry"/></mxCell><mxCell id="c53" value="層 3 entityReducer&lt;br&gt;(配列 payload を 1 件ずつ分割)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1394" y="666" width="250" height="76" as="geometry"/></mxCell><mxCell id="c54" value="変えない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1652" y="666" width="250" height="76" as="geometry"/></mxCell><mxCell id="c55" value="cms/components で取った本体" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="750" width="200" height="76" as="geometry"/></mxCell><mxCell id="c56" value="API の形のまま" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1028" y="750" width="160" height="76" as="geometry"/></mxCell><mxCell id="c57" value="API の形のまま + pageContext" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1196" y="750" width="190" height="76" as="geometry"/></mxCell><mxCell id="c58" value="層 1 は無し(CMS_COMPONENT_NORMALIZER&lt;br&gt;の既定登録 0 件)。層 2 ComponentsEffects" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1394" y="750" width="250" height="76" as="geometry"/></mxCell><mxCell id="c59" value="CMS_COMPONENT_NORMALIZER に&lt;br&gt;multi 追加(既定は空)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1652" y="750" width="250" height="76" as="geometry"/></mxCell><mxCell id="c60" value="読み方: 青 = 層 1 Normalizer(アダプタ層、DI の multi provider で差し替え可)、紫 = 層 2 Effect、橙 = 層 3 Reducer、緑 = State 側の形、赤 = 注意点。&lt;br&gt;API → State の変換はこの 3 層に分散している。State の形を変えたい場合の入口は CMS_PAGE_NORMALIZER / CMS_COMPONENT_NORMALIZER で、Effect と Reducer には手を入れない。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="870" width="1060" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="14 ルーティングと配置: 普通の Angular との違い" id="14 ルーティングと配置: 普通の Angular との違い"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="普通の Angular では自分で書く「URL → コンポーネントの表」と「どこに何を置くかのテンプレート」を、Spartacus は誰がどう持っているか。左: ルーティング。右: 配置は「文字列をキーに 4 つの表を引く」の繰り返し。3 章" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1740" height="30" as="geometry"/></mxCell><mxCell id="c3" value="A. ルーティング: URL とページの対応表は誰が持つか" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="720" height="900" as="geometry"/></mxCell><mxCell id="c4" value="普通の Angular" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="300" height="24" as="geometry"/></mxCell><mxCell id="c5" value="routes 表(自分で書く)&lt;br&gt;/products/:id → ProductComponent&lt;br&gt;/cart → CartComponent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="128" width="230" height="80" as="geometry"/></mxCell><mxCell id="c6" value="Angular Router&lt;br&gt;パスを表で引く" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="128" width="170" height="80" as="geometry"/></mxCell><mxCell id="c7" value="URL ごとに違う&lt;br&gt;コンポーネントが出る" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="540" y="128" width="200" height="80" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="Spartacus" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="232" width="300" height="24" as="geometry"/></mxCell><mxCell id="c11" value="URL&lt;br&gt;/electronics-spa/en/USD/faq" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="320" height="56" as="geometry"/></mxCell><mxCell id="c12" value="&amp;#x27;**&amp;#x27; ルートが 1 本だけ(起動時に追加)&lt;br&gt;canActivate: CmsPageGuard&lt;br&gt;component: PageLayoutComponent&lt;br&gt;→ どの URL でも同じ 1 つのルートに当たる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="320" height="90" as="geometry"/></mxCell><mxCell id="c13" value="URL → ページの問い合わせキー(PageContext)&lt;br&gt;productCode あり → {ProductPage, &amp;#x27;300938&amp;#x27;}&lt;br&gt;categoryCode あり → {CategoryPage, code}&lt;br&gt;どれでもない → {ContentPage, &amp;#x27;/faq&amp;#x27;}(URL の残りがラベル)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="454" width="320" height="100" as="geometry"/></mxCell><mxCell id="c14" value="CmsPageGuard&lt;br&gt;GET cms/pages?pageType=ContentPage&amp;amp;pageLabelOrId=/faq" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="578" width="320" height="64" as="geometry"/></mxCell><mxCell id="c15" value="CMS のページ表(Backoffice が持つ)&lt;br&gt;ラベル /faq → ContentPage1Template + スロット構成&lt;br&gt;ラベル /campaign を作れば、フロント無変更で開く" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="666" width="320" height="86" as="geometry"/></mxCell><mxCell id="c16" value="あれば PageLayoutComponent を出す&lt;br&gt;無ければ 404 ページ(notFound ラベル)へ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="776" width="320" height="64" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="例外: パスの「パターン」だけはフロント設定&lt;br&gt;商品: path: null + data.cxRoute=&amp;#x27;product&amp;#x27;&lt;br&gt;→ 起動時に routing.routes.product.paths&lt;br&gt;  [&amp;#x27;product/:productCode/:name&amp;#x27;, …] で埋まる&lt;br&gt;カテゴリ・検索・マイアカウント系も同じ方式&lt;br&gt;&lt;br&gt;ただし component はやはり PageLayoutComponent。&lt;br&gt;パターンは productCode を取り出すための入口で、&lt;br&gt;画面の中身は CMS が返すスロット構成で決まる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="410" y="340" width="330" height="214" as="geometry"/></mxCell><mxCell id="c23" value="結論&lt;br&gt;URL とページの対応表はフロントの routes ではなく、&lt;br&gt;CMS のページラベルが持っている。&lt;br&gt;フロントが持つのは「URL をキーに変える規則」と&lt;br&gt;「商品・カテゴリなどのパスのパターン」だけ。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="410" y="578" width="330" height="130" as="geometry"/></mxCell><mxCell id="c24" value="根拠: add-cms-route.ts:12-16 / router.reducer.ts:169-215 / cms-page.guard.ts:51-84 / product-details-page.module.ts:17-23 / configurable-routes.service.ts:48-100" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="860" width="680" height="40" as="geometry"/></mxCell><mxCell id="c25" value="B. 配置: 「文字列をキーに表を引く」を 4 回繰り返す(橙 = CMS / Backoffice が持つ表、青 = フロント設定の表、緑 = 画面に起きること)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#d79b00;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="800" y="70" width="980" height="900" as="geometry"/></mxCell><mxCell id="c26" value="外枠 storefront.component.html(普通の Angular と同じ直書き)&lt;br&gt;[ ヘッダ枠(固定スロット) ]  [ &amp;lt;router-outlet&amp;gt; ← PageLayoutComponent ]  [ フッタ枠 ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="940" height="56" as="geometry"/></mxCell><mxCell id="c27" value="表① cms/pages の応答(CMS が持つ)&lt;br&gt;template: &amp;#x27;LandingPage2Template&amp;#x27;&lt;br&gt;slots: { Section1:{…}, Section2A:{…}, … }   ← 辞書。順番は無い" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="190" width="400" height="104" as="geometry"/></mxCell><mxCell id="c28" value="PageLayoutComponent&lt;br&gt;応答の template 名を取り出し、その名前で表②を引く" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="190" width="500" height="104" as="geometry"/></mxCell><mxCell id="c29" value="表② LayoutConfig.layoutSlots[template].slots(フロント設定)&lt;br&gt;LandingPage2Template: [&amp;#x27;Section1&amp;#x27;,&amp;#x27;Section2A&amp;#x27;,&amp;#x27;Section2B&amp;#x27;,&amp;#x27;Section2C&amp;#x27;,&lt;br&gt;&amp;#x27;Section3&amp;#x27;,&amp;#x27;Section4&amp;#x27;,&amp;#x27;Section5&amp;#x27;]   ← 縦に並べる順番はここ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="322" width="400" height="104" as="geometry"/></mxCell><mxCell id="c30" value="*ngFor 1 回目: 表② にあって表① にもあるスロットだけ、順に&lt;br&gt;&amp;lt;cx-page-slot position=&amp;#x27;Section1&amp;#x27;&amp;gt; &amp;lt;cx-page-slot position=&amp;#x27;Section2A&amp;#x27;&amp;gt; …&lt;br&gt;空の箱が並ぶ。表② に無いスロットは描かれない(dev 警告)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="322" width="500" height="104" as="geometry"/></mxCell><mxCell id="c31" value="表③ 応答の slots[position].components(CMS が持つ)&lt;br&gt;[ {uid, typeCode:&amp;#x27;CMSParagraphComponent&amp;#x27;, flexType, properties}, … ]&lt;br&gt;並び順 = Backoffice でスロットに並べた順" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="454" width="400" height="104" as="geometry"/></mxCell><mxCell id="c32" value="*ngFor 2 回目: 各 &amp;lt;cx-page-slot&amp;gt; が自分の position で表③を引き、&lt;br&gt;1 件ごとに &amp;lt;ng-container cxComponentWrapper&amp;gt; を置く" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="454" width="500" height="104" as="geometry"/></mxCell><mxCell id="c33" value="表④ CmsConfig.cmsComponents[flexType](フロント設定)&lt;br&gt;provideConfig({ cmsComponents: {&lt;br&gt;  CMSParagraphComponent: { component: ParagraphComponent } } })" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="586" width="400" height="104" as="geometry"/></mxCell><mxCell id="c34" value="cxComponentWrapper: flexType で表④を引き、&lt;br&gt;ViewContainerRef.createComponent(クラス, injector) で「その場に」生やす&lt;br&gt;子 Injector に CmsComponentData{uid, data$} を入れておく&lt;br&gt;表④に無い typeCode → 何も生えず空(本番は無言、dev 警告)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="586" width="500" height="124" as="geometry"/></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c29" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c31" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c26" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c28" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c30" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c32" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="バックエンドが触るもの: template 名・スロット名・typeCode・並び順(表①③)。&lt;br&gt;フロントに頼むのは 2 つだけ: 新しいテンプレート / スロット → 表②に追加。新しい typeCode → 表④に追加。&lt;br&gt;「配置」は普通の Angular のテンプレートではなく、この 4 つの表の組み合わせで決まる。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="748" width="940" height="80" as="geometry"/></mxCell><mxCell id="c44" value="根拠: storefront.component.html / page-layout.component.html / page-layout.service.ts:106-127 / recipes/config/layout-config.ts:55-64 / page-slot.component.html / component-wrapper.directive.ts:81-117 / default-component.handler.ts:56-70" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="920" width="940" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="15 変更検知の 3 段階と dirty の経路" id="15 変更検知の 3 段階と dirty の経路"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="API の応答が State に入ったあと、Angular はどの view を評価し、どの DOM を触るのか。左: 3 段階(A いつ / B どの view / C どのバインディング)。右: ソート 1 回とホーム再訪 1 回を view の木で見る。16 章" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1740" height="30" as="geometry"/></mxCell><mxCell id="c3" value="A → B → C: 応答が届いてから DOM が変わるまでの 3 段階" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="720" height="900" as="geometry"/></mxCell><mxCell id="c4" value="きっかけ&lt;br&gt;クリック / OCC 応答(XHR 完了) / タイマー完了" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="110" width="660" height="50" as="geometry"/></mxCell><mxCell id="c5" value="A. tick の予約(いつ走るか)&lt;br&gt;zone.js がマクロタスクの終わりに ApplicationRef.tick() を予約。eventCoalescing で 1 回にまとめる&lt;br&gt;markForCheck() 自身も予約する(markViewDirty → changeDetectionScheduler.notify)&lt;br&gt;→ OCC 応答のたびに最低 1 回、クリックのたびに 1 回" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="185" width="660" height="90" as="geometry"/></mxCell><mxCell id="c6" value="B-1. 印を付ける(markViewDirty)&lt;br&gt;自分から根元まで親を辿って全部に付ける。兄弟には付けない&lt;br&gt;入口 1: AsyncPipe が新しい値を受け取る → markForCheck()   ← API 応答はここから入る&lt;br&gt;入口 2: テンプレート内の DOM イベント(wrapListener)&lt;br&gt;入口 3: OnPush コンポーネントの @Input が変わった" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="300" width="660" height="104" as="geometry"/></mxCell><mxCell id="c7" value="B-2. tick: view ごとに評価するか決める(detectChangesInView)&lt;br&gt;評価する: Default(CheckAlways) / dirty / RefreshView / signal が変化&lt;br&gt;評価しない: OnPush で印なし。子孫に印があれば「通過」するだけでテンプレートは一切評価しない&lt;br&gt;Spartacus: storefront 98 コンポーネント中 67 が OnPush(PageSlot / PageLayout / Banner / Paragraph …)&lt;br&gt;Default は StorefrontComponent と ProductListComponent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="428" width="660" height="104" as="geometry"/></mxCell><mxCell id="c8" value="C の前段: Observable の中で止める&lt;br&gt;PageSlot: uid の並びが同じなら流さない(isDistinct) → components 配列が差し替わらず *ngFor が動かない&lt;br&gt;PageLayoutService.getSlots: スロット名を 1 つずつ比較 → 同じなら &amp;lt;cx-page-slot&amp;gt; を残す&lt;br&gt;→ ヘッダー・フッターのコンポーネントは破棄も生成もされない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="556" width="660" height="90" as="geometry"/></mxCell><mxCell id="c9" value="C. 評価した view の中で、変わったバインディングだけ DOM に書く&lt;br&gt;値: Object.is で比較。innerHTML の文字列が同じなら書かない&lt;br&gt;*ngFor(trackBy なし): 新しい配列 → 行を全部破棄して作り直す(商品一覧)&lt;br&gt;*ngFor(文字列配列): 値で比較 → 同じ名前なら残す(スロットの並び)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="670" width="660" height="90" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="結論: どの DOM が変わるかは「誰が何を | async しているか」という購読の配線と、Angular の規則で機械的に決まる。&lt;br&gt;フロントが「ヘッダーは除外」と書いているのではない。API の本数と DOM の書き換え量は別の軸。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="790" width="660" height="70" as="geometry"/></mxCell><mxCell id="c16" value="根拠: app.config.ts:30 / @angular/core 21.2.25 _debug_node-chunk.mjs:5900-5915(detectChangesInView), 5967-5977(markViewDirty), 6142-6144(markForCheck), 8225-8232(wrapListener) / @angular/common _common_module-chunk.mjs:2601-2605(AsyncPipe) / page-slot.component.ts:51, 97-101, 124-130, 201-213 / page-layout.service.ts:68-78 / product-list.component.html:54, 64" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="70" y="870" width="660" height="80" as="geometry"/></mxCell><mxCell id="c17" value="view の木で見る 2 つの実例(橙 = 印が付いて評価される、灰 = 印なしで飛ばされる、緑 = Default なので評価されるが DOM は不変、赤枠 = DOM を触る)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#d79b00;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="800" y="70" width="980" height="900" as="geometry"/></mxCell><mxCell id="c18" value="実例 1 ソート: クリック → products/search 1 本 → 応答 → ProductList の model$ | async が印 → 経路だけ評価。Guard も cms/pages も走らない(3.0, 16.5)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="104" width="940" height="40" as="geometry"/></mxCell><mxCell id="c19" value="App(Default)&lt;br&gt;評価、DOM 不変" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1195" y="150" width="190" height="56" as="geometry"/></mxCell><mxCell id="c20" value="StorefrontComponent(Default)&lt;br&gt;評価、DOM 不変" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1195" y="230" width="190" height="56" as="geometry"/></mxCell><mxCell id="c21" value="PageLayout[header](OnPush)&lt;br&gt;印なし → 飛ばされる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="830" y="320" width="220" height="56" as="geometry"/></mxCell><mxCell id="c22" value="header の PageSlot / Logo /&lt;br&gt;SearchBox / Navigation&lt;br&gt;評価されない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="830" y="410" width="220" height="64" as="geometry"/></mxCell><mxCell id="c23" value="PageLayout[main](OnPush)&lt;br&gt;印あり → 評価、DOM 不変" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1195" y="320" width="190" height="56" as="geometry"/></mxCell><mxCell id="c24" value="PageSlot[ProductListSlot](OnPush)&lt;br&gt;印あり → 評価、DOM 不変" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1195" y="410" width="210" height="56" as="geometry"/></mxCell><mxCell id="c25" value="ProductListComponent(Default)&lt;br&gt;印の起点: model$ | async が markForCheck&lt;br&gt;DOM: 商品行を全部作り直し(trackBy なし)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1150" y="500" width="300" height="70" as="geometry"/></mxCell><mxCell id="c26" value="PageLayout[footer](OnPush)&lt;br&gt;印なし → 飛ばされる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1560" y="320" width="200" height="56" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c20" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c20" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="実例 2 ホーム再訪(商品詳細 → ホーム): cms/pages 1 本 → State を同じ値で上書き → data$ を持つ全 view に印 → 評価されるが、値が同じなので DOM は 1 箇所も変わらない(16.6)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="600" width="940" height="40" as="geometry"/></mxCell><mxCell id="c35" value="App / StorefrontComponent(Default)&lt;br&gt;評価、DOM 不変" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1195" y="646" width="210" height="56" as="geometry"/></mxCell><mxCell id="c36" value="PageLayout[header](OnPush)&lt;br&gt;子孫に印 → 通過・評価" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="830" y="730" width="220" height="56" as="geometry"/></mxCell><mxCell id="c37" value="PageLayout[main](OnPush)&lt;br&gt;再利用(同じ ** ルート)、評価" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1195" y="730" width="210" height="56" as="geometry"/></mxCell><mxCell id="c38" value="PageLayout[footer](OnPush)&lt;br&gt;子孫に印 → 通過・評価" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1560" y="730" width="200" height="56" as="geometry"/></mxCell><mxCell id="c39" value="各 PageSlot: isDistinct で止まる&lt;br&gt;(uid の並びが同じ) → *ngFor 動かず&lt;br&gt;破棄も生成も無し" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="830" y="815" width="220" height="70" as="geometry"/></mxCell><mxCell id="c40" value="Banner / Paragraph / Logo …&lt;br&gt;data$ が新オブジェクト → 印 → 評価&lt;br&gt;innerHTML の文字列が同じ → DOM 不変" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1130" y="815" width="340" height="70" as="geometry"/></mxCell><mxCell id="c41" value="ナビゲーション&lt;br&gt;同上。子項目は State 済み&lt;br&gt;→ cms/components も飛ばない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1560" y="815" width="200" height="70" as="geometry"/></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c35" target="c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c35" target="c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c35" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c36" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c37" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c38" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c48" value="ソートと再訪の違い: ソートは API 1 本で商品行を全部作り直す。再訪は API 1 本で DOM を 1 箇所も触らない。API の本数と描画コストは別の軸(16.7)。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="905" width="940" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="16 zone.js の見張りと dirty の 2 つの時刻" id="16 zone.js の見張りと dirty の 2 つの時刻"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="zone.js は何を見張っていて、いつ tick を起こすのか。印が付く時刻と見つかる時刻はなぜ分かれるのか。左: zone.js → NgZone → tick。右: クリック 1 回と OCC 応答 1 回を時間軸で。17 章" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1740" height="30" as="geometry"/></mxCell><mxCell id="c3" value="zone.js → NgZone → tick: 歩く人はいつ来るか" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="760" height="900" as="geometry"/></mxCell><mxCell id="c4" value="zone.js がブラウザ API を差し替える(読み込み時)&lt;br&gt;setTimeout / addEventListener / XHR / Promise.then / fetch / queueMicrotask → すべて「タスク」になる(zone.js:1680-2327)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="110" width="700" height="56" as="geometry"/></mxCell><mxCell id="c5" value="タスクを数える&lt;br&gt;scheduleTask で +1、runTask の finally で -1(zone.js:187-214, 144-186)。0 ↔ 1 の瞬間だけ onHasTask(:403-418)&lt;br&gt;Promise の続きは自前のキューに積み、タスクの終わりにまとめて流す(:452-468, 538-566)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="186" width="700" height="72" as="geometry"/></mxCell><mxCell id="c6" value="NgZone の &amp;#x27;angular&amp;#x27; zone のフック(_effect-chunk2.mjs:2529-2585)&lt;br&gt;onInvokeTask / onInvoke: 入るとき onEnter(isStable=false)、出るとき onLeave → checkStable&lt;br&gt;onHasTask(microTask の増減): hasPendingMicrotasks を更新 → checkStable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="278" width="700" height="72" as="geometry"/></mxCell><mxCell id="c7" value="checkStable の 3 条件(:2487-2502)&lt;br&gt;① 実行中のタスクが無い(_nesting == 0) ② Angular zone のマイクロタスクが 0 ③ 前回 stable 以降に何か動いた&lt;br&gt;マクロタスク(HTTP や setTimeout の残り)は見ない → 「全部返ってきたら」ではなく「今の仕事が終わったら」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="370" width="700" height="76" as="geometry"/></mxCell><mxCell id="c8" value="eventCoalescing: true(app.config.ts:30)&lt;br&gt;DOM イベントの直後だけ ② をわざと偽にして止め、rAF / setTimeout(0) の早い方で checkStable(:2504-2527)。マイクロタスクには効かない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="466" width="700" height="56" as="geometry"/></mxCell><mxCell id="c9" value="onMicrotaskEmpty → NgZoneChangeDetectionScheduler(core.mjs:299-325)&lt;br&gt;appRef.dirtyFlags |= 1(Global)→ ApplicationRef._tick()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="542" width="700" height="50" as="geometry"/></mxCell><mxCell id="c10" value="tick(_debug_node-chunk.mjs:12396-12498)&lt;br&gt;synchronize → synchronizeOnce → 各 root view を detectChangesInternal(mode 0 Global)&lt;br&gt;→ detectChangesInView(:5900-5933)が view ごとにフラグを読む・決める・消す(1024|8192 は判定直後 :5913、64 は評価後 :5848)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="612" width="700" height="76" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="結論: 印を付ける人と印を見つける人は別。付けるのは値が変わったコードの中(同期)、見つけるのは tick の中だけ。&lt;br&gt;tick は「Angular zone のマイクロタスクが 0 になった瞬間」に走る。HTTP の本数ではなく、仕事の区切りの数だけ走る。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="712" width="700" height="70" as="geometry"/></mxCell><mxCell id="c18" value="印の 3 つの入口と時刻: ① async パイプ = 値が流れた瞬間(応答処理の中) ② DOM イベント = ハンドラの前(wrapListener :8232) ③ @Input = 親の tick の最中(同じ tick の数十行あとで見つかる)&lt;br&gt;tick の中で付いた 64 は、その tick では見つからない(requiresRefreshOrTraversal は 1024 / 8192 / consumer.dirty しか見ない)→ 次の tick へ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="798" width="700" height="72" as="geometry"/></mxCell><mxCell id="c19" value="根拠: zone.js 0.16.3 / @angular/core 21.2.25 / @angular/common _module-chunk.mjs:761-850(FetchBackend は fetch と body 読み取りを zone の外で行う)/ @angular/build utils.js:160-167, 366-373(zone.js ありなら async/await を then に落とす)/ projects/storefrontapp/project.json:23, app.config.ts:28, 30" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="70" y="884" width="700" height="70" as="geometry"/></mxCell><mxCell id="c20" value="時間軸(橙 = 印を付ける、緑 = tick で印を見つけて消す、灰 = zone の外や印に関係ない処理)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#d79b00;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="840" y="70" width="940" height="900" as="geometry"/></mxCell><mxCell id="c21" value="実例 1 ソートのクリック(16.5)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="860" y="104" width="440" height="24" as="geometry"/></mxCell><mxCell id="c22" value="t1 click → zone.js globalCallback → invokeTask → onEnter(isStable = false)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="134" width="440" height="44" as="geometry"/></mxCell><mxCell id="c23" value="t1 wrapListener がハンドラの前に markViewDirty(ProductList, 5)&lt;br&gt;ProductList → PageSlot → PageLayout[main] → Storefront → App → root に 64|1024" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="192" width="440" height="56" as="geometry"/></mxCell><mxCell id="c24" value="t1 ハンドラ: アクション → Effect → HttpClient → fetch 開始(zone の外)&lt;br&gt;ハンドラ終了 → eventTask + eventCoalescing → checkStable を保留" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="262" width="440" height="56" as="geometry"/></mxCell><mxCell id="c25" value="t2 次フレーム(rAF / setTimeout 0)→ checkStable → onMicrotaskEmpty → tick #1&lt;br&gt;印の道筋だけ評価。header / footer は飛ばす。印を消す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="332" width="440" height="56" as="geometry"/></mxCell><mxCell id="c26" value="t3 応答ヘッダ → fetch の Promise 解決。ボディ読み取りは zone の外(tick なし)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="402" width="440" height="44" as="geometry"/></mxCell><mxCell id="c27" value="t4 await の続きが Angular zone のマイクロタスクで走る&lt;br&gt;observer.next → reducer → selector → async パイプ markForCheck&lt;br&gt;ProductList → root に 64|1024" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="460" width="440" height="64" as="geometry"/></mxCell><mxCell id="c28" value="t4 マイクロタスク終了 → 数が 0 → onHasTask → checkStable → tick #2 その場で&lt;br&gt;ProductList を評価、行を作り直し(16.4)。印を消す。coalescing は効かない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="538" width="440" height="56" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="実例 2 ホーム再訪: Router + cms/pages(16.6)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1320" y="104" width="440" height="24" as="geometry"/></mxCell><mxCell id="c36" value="t1 リンクの click → wrapListener で印 → Router が遷移を開始" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1320" y="134" width="440" height="44" as="geometry"/></mxCell><mxCell id="c37" value="t1&amp;#x27; 次フレームで tick #1(リンクの view の道筋だけ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1320" y="192" width="440" height="44" as="geometry"/></mxCell><mxCell id="c38" value="t2… Router の各段(Guard / cms/pages の fetch / NavigationEnd)は Promise の連鎖&lt;br&gt;= マイクロタスク。段が終わるたびに checkStable → tick" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1320" y="250" width="440" height="56" as="geometry"/></mxCell><mxCell id="c39" value="応答 → State を同じ値で上書き → data$ | async を持つ全 view が markForCheck&lt;br&gt;(Banner / Paragraph / Logo / Navigation …)→ それぞれ root まで 64|1024" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1320" y="320" width="440" height="56" as="geometry"/></mxCell><mxCell id="c40" value="tick #2…#n 印の付いた view を全部評価&lt;br&gt;bindingUpdated が全部 false → DOM は 1 箇所も変わらない(16.6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1320" y="390" width="440" height="56" as="geometry"/></mxCell><mxCell id="c41" value="遷移 1 回で tick は複数回。tick の回数と DOM を触った回数は別の軸。&lt;br&gt;tick 1 回の費用 = 印の道筋 + Default の view(App / Storefront / ProductList)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1320" y="460" width="440" height="56" as="geometry"/></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c36" target="c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c37" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c38" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c39" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c40" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c47" value="本家の OCC 応答が Angular zone に戻る経路(17.3)&lt;br&gt;FetchBackend は fetch とボディ読み取りを runOutsideAngular で行う(_module-chunk.mjs:793, 834)。&lt;br&gt;しかし doRequest は Observable の購読時 = Angular zone の中で始まるので、runOutsideAngular の外側の await の続き(observer.next)は Angular zone に戻る。&lt;br&gt;これは CLI が zone.js ありのアプリで async/await を Promise.then に落とすから(@angular/build utils.js:160-167, 366-373)。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="630" width="900" height="96" as="geometry"/></mxCell><mxCell id="c48" value="きっかけ別の tick の時刻&lt;br&gt;クリック: リスナ終了 → 次フレーム(coalescing) / setTimeout 完了(ミニアプリの擬似 OCC): その場 / Promise・await の続き: その場 / OCC 応答(fetch): 応答処理の続きが終わった瞬間 / Router 遷移: 段ごとに複数回 / zone の外からの markForCheck・signal.set: scheduler が rAF / setTimeout で予約(hybrid)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="744" width="900" height="90" as="geometry"/></mxCell><mxCell id="c49" value="ミニアプリの観測パネル(playground/mini-spartacus)の CD 行は afterEveryRender で tick の終わりを検出する(debug-log.service.ts:29)。ソートで CD 行が 2 行(t2 と t4)出て、どちらにも PageLayout[header] が無いのはこの時間軸のとおり。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="860" y="850" width="900" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="17 Signal の反応グラフと async パイプとの違い" id="17 Signal の反応グラフと async パイプとの違い"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Signal は Observable + async パイプと何が違うのか。印はどこに付き、誰が tick を予約するのか。左: 値が変わってから DOM が変わるまでの 2 つの経路。右: producer / consumer のリンクと set() の経路。18 章" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1740" height="30" as="geometry"/></mxCell><mxCell id="c3" value="値が変わってから DOM が変わるまで: 2 つの経路を並べる" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="900" height="900" as="geometry"/></mxCell><mxCell id="c4" value="Observable + async パイプ(Spartacus の主経路)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="104" width="410" height="24" as="geometry"/></mxCell><mxCell id="c5" value="signal をテンプレートで読む" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="510" y="104" width="410" height="24" as="geometry"/></mxCell><mxCell id="c6" value="値が変わる: reducer が State を書き換え、selector が新しい値を流す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="134" width="410" height="56" as="geometry"/></mxCell><mxCell id="c7" value="値が変わる: s.set(v)。equal(既定は Object.is 相当)で同じなら何もしない。印も付かない(_effect-chunk.mjs:365-372)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510" y="134" width="410" height="56" as="geometry"/></mxCell><mxCell id="c8" value="印: AsyncPipe._updateLatestValue → markForCheck → markViewDirty&lt;br&gt;自分〜根元に 64|1024(「購読している view」単位、_common_module-chunk.mjs:2601-2607)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="204" width="410" height="72" as="geometry"/></mxCell><mxCell id="c9" value="印: signalValueChanged → producerNotifyConsumers → consumerMarkDirty → consumerMarkedDirty&lt;br&gt;読んだ view に consumer.dirty、先祖に 8192 だけ(markAncestorsForTraversal、_debug_node-chunk.mjs:5645-5647)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510" y="204" width="410" height="72" as="geometry"/></mxCell><mxCell id="c10" value="tick の予約: 自分ではしない。zone が起こす tick を待つ(17 章)。zone の外なら notify(4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="290" width="410" height="60" as="geometry"/></mxCell><mxCell id="c11" value="tick の予約: notify(0) → dirtyFlags |= 2。zone の中なら zone に任せ、外なら rAF / setTimeout で自前(18.4)。zone が無くても動く" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510" y="290" width="410" height="60" as="geometry"/></mxCell><mxCell id="c12" value="評価判定: detectChangesInView の flags &amp;amp; 64 / flags &amp;amp; 1024&lt;br&gt;OnPush でないと Global の tick で毎回評価される" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="364" width="410" height="72" as="geometry"/></mxCell><mxCell id="c13" value="評価判定: 同じ関数の consumer.dirty &amp;amp;&amp;amp; consumerPollProducersForChange(version 比較、:5908)&lt;br&gt;OnPush かどうかに依らず「読んだ view」だけ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510" y="364" width="410" height="72" as="geometry"/></mxCell><mxCell id="c14" value="DOM: bindingUpdated の Object.is で変わったバインディングだけ(16.4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="450" width="410" height="56" as="geometry"/></mxCell><mxCell id="c15" value="DOM: 同じ。その前に equal と computed の version 比較で評価そのものが止まる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510" y="450" width="410" height="56" as="geometry"/></mxCell><mxCell id="c16" value="購読の開始: async パイプが初めて評価されたとき(遅延)&lt;br&gt;= 8.0 規則 3「購読した瞬間に取りに行く」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="520" width="410" height="72" as="geometry"/></mxCell><mxCell id="c17" value="購読の開始: toSignal は作った瞬間(rxjs-interop.mjs:126-141)&lt;br&gt;= コンポーネント生成時に API が飛ぶ。*ngIf で隠れていても" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510" y="520" width="410" height="72" as="geometry"/></mxCell><mxCell id="c18" value="結論: signal が変えるのは「どの view に印が付くか」と「誰が tick を予約するか」だけ。API の本数・応答の形・State の形は変わらない。&lt;br&gt;バックエンド側で signal の有無によって変えることは無い。変わるのは購読の開始時刻(toSignal は生成時)。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="612" width="850" height="72" as="geometry"/></mxCell><mxCell id="c19" value="根拠: _effect-chunk.mjs:26-41(REACTIVE_NODE), 43-87(producerAccessed), 91-103(producerUpdateValueVersion), 105-129, 163-178, 340-396 / _debug_node-chunk.mjs:5641-5677(テンプレートの consumer), 5758-5770, 5908-5912, 18262-18266 / _effect-chunk2.mjs:1781-1805, 2884-3011(effect) / rxjs-interop.mjs:74-158 / core.mjs:25-57(input)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="70" y="698" width="850" height="70" as="geometry"/></mxCell><mxCell id="c20" value="反応グラフ: 誰が誰を読んだか(producer → consumer)と、set() が印を付ける経路" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#d79b00;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="980" y="70" width="800" height="900" as="geometry"/></mxCell><mxCell id="c21" value="signal: storeCode&lt;br&gt;version = 3, value = &amp;#x27;0001&amp;#x27;&lt;br&gt;consumers → [computed hours]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="120" width="230" height="70" as="geometry"/></mxCell><mxCell id="c22" value="input(): productCode&lt;br&gt;親テンプレートの [productCode] が親の tick の中で set() する(18.7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1300" y="120" width="230" height="70" as="geometry"/></mxCell><mxCell id="c23" value="computed: hours&lt;br&gt;producers → [storeCode @ v3]&lt;br&gt;読まれたときに version を比べ、違えば再計算(18.2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="240" width="230" height="80" as="geometry"/></mxCell><mxCell id="c24" value="テンプレートの consumer(lView)&lt;br&gt;hours() を読んだ瞬間にリンクが張られる&lt;br&gt;REACTIVE_TEMPLATE_CONSUMER(:5648-5650)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1300" y="240" width="230" height="80" as="geometry"/></mxCell><mxCell id="c25" value="effect(view): フォーカス制御など&lt;br&gt;refreshView の中、テンプレートの後で実行(:5795)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="370" width="230" height="64" as="geometry"/></mxCell><mxCell id="c26" value="effect(root) / toObservable&lt;br&gt;synchronizeOnce の先頭で flush(:12454-12457)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1300" y="370" width="230" height="64" as="geometry"/></mxCell><mxCell id="c27" value="読む" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c21" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="読む" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="読む" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c22" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="読む" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c23" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="読む" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c21" target="c26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1125" y="105"/><mxPoint x="1415" y="105"/></Array></mxGeometry></mxCell><mxCell id="c32" value="storeCode.set(&amp;#x27;0002&amp;#x27;) の経路(同期、値は渡さない)&lt;br&gt;① version++、epoch++(_effect-chunk.mjs:391-396) ② consumers を辿って consumerMarkDirty(computed → テンプレートの consumer → effect)&lt;br&gt;③ テンプレート consumer の consumerMarkedDirty → markAncestorsForTraversal: 先祖に 8192、changeDetectionScheduler.notify(0)&lt;br&gt;④ effect は scheduler に予約(root)/ view に 8192(view)。実行は次の tick" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="470" width="740" height="96" as="geometry"/></mxCell><mxCell id="c33" value="次の tick で: detectChangesInView が consumer.dirty を見つけ、version 比較で本当に変わっていれば評価(:5908)&lt;br&gt;先祖(8192)は通過するだけ。兄弟は触らない。評価の中で bindingUpdated が変わった箇所だけ DOM へ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="586" width="740" height="60" as="geometry"/></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="Spartacus 2612 の実態: signal 系 API は 24 箇所 / 12 ファイル(spec 除く)。State → view の主経路(data$ / ProductService / Facade)は Observable + async のまま&lt;br&gt;・consent-management.component.ts:72: isLoading = signal(false)(コード内で読む状態の入れ物)&lt;br&gt;・subscription-product-price.component.ts:33-50: toSignal + computed × 3 → テンプレートで oneTimeCharges()&lt;br&gt;・order-attachments-dialog.component.ts:42, 86-90: OnPush + signal + toSignal(initialValue: 0)&lt;br&gt;・store-finder-list.component.ts:68, 79-81: viewChild signal + effect でフォーカス&lt;br&gt;・http-error-handler.interceptor.ts:46: toSignal(userId)(サービス内で購読なしに最新値を読む)&lt;br&gt;・NgRx の selectSignal は本体で 0 件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="666" width="740" height="130" as="geometry"/></mxCell><mxCell id="c36" value="カスタム実装で signal を選ぶとき(18.8): Facade(15 章)はそのまま。コンポーネントで toSignal(component.data$) → computed → toObservable → switchMap(facade.getHours) → toSignal。&lt;br&gt;変わるのは購読の開始時刻だけ。/stores/{code}/hours が 1 本飛ぶ事実と応答の形は同じ。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="812" width="740" height="72" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="18 Query の状態機械と Command の戦略" id="18 Query の状態機械と Command の戦略"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Facade の中身が Query / Command のとき、API はいつ飛び、いつ取り直され、いつ捨てられるのか。左: Query の 1 つの状態と遷移。中: Command の 4 strategy。右: EventService が結ぶ「書く → イベント → 取り直す」。19 章" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1740" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Query: BehaviorSubject 1 つ { loading, error, data } と 3 本の配線(query.service.ts:52-142)。橙 = API が飛ぶ遷移、灰 = 飛ばない" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="640" height="900" as="geometry"/></mxCell><mxCell id="c4" value="初期状態 { loading: true, error: false, data: undefined }(:61-67)&lt;br&gt;Query を作っただけでは何も起きない(spec: should not load if not subscribed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="110" width="580" height="56" as="geometry"/></mxCell><mxCell id="c5" value="1 人目が購読(using :131-134)→ onSubscribeLoad$ が「ロードせよ」(:71-75)&lt;br&gt;→ loader 実行 → { loading: false, data }(:94-97)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="186" width="580" height="56" as="geometry"/></mxCell><mxCell id="c6" value="2 人目の購読 / 全員が去ったあとの再購読&lt;br&gt;→ state$ の最新値が流れるだけ。loading: false なので onSubscribeLoad$ は EMPTY = 取得済みなら取らない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="262" width="580" height="56" as="geometry"/></mxCell><mxCell id="c7" value="ロード中に全員が購読解除 → load$ の購読解除で loader 中断。loading: true のまま残る(:69-70)&lt;br&gt;→ 次の購読で onSubscribeLoad$ が再び発火して取り直す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="338" width="580" height="56" as="geometry"/></mxCell><mxCell id="c8" value="reloadOn のイベント(:106-114)→ { ...前の値, loading: true }: data は保持して裏で取り直す(ちらつかない)&lt;br&gt;購読者がいなければ印だけ付け、次の購読で取る" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="414" width="580" height="56" as="geometry"/></mxCell><mxCell id="c9" value="resetOn のイベント(:117-129)→ 即 initialState(data: undefined)。進行中の loader は takeUntil で中断(:86)&lt;br&gt;購読者がいれば直ちに再ロード。loading を見ている画面はスピナーに戻る" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="490" width="580" height="56" as="geometry"/></mxCell><mxCell id="c10" value="loader がエラー → { loading: false, error, data: undefined }(:98-101)&lt;br&gt;load$ は sourceStream$ を返して生き続ける → 次のトリガーで再試行。成功で error は消える" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="566" width="580" height="56" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="get() = state$ → data → distinctUntilChanged(:136-139)。getState() = { loading, error, data } そのもの。&lt;br&gt;async パイプが購読 → 値が来るたびに markForCheck → 印 → tick(16〜17 章)。state$ は NgRx ストアの外: DevTools に出ず、SSR の TransferState の対象でもない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="646" width="580" height="70" as="geometry"/></mxCell><mxCell id="c18" value="API が飛ぶ瞬間は 4 つだけ: 初回購読 / 中断後の再購読 / reloadOn / resetOn。&lt;br&gt;パラメータは Query に無い → 前提条件ヘルパで take(1)(チケット 1 件)、呼ぶたびに create(チケット一覧)、loader 内で switchMap(見積一覧)の 3 通り" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="732" width="580" height="70" as="geometry"/></mxCell><mxCell id="c19" value="根拠: query.service.ts:31-42, 52-142, 144-155 / query.service.spec.ts:56-364 / customer-ticketing.service.ts:191-227, 254-270 / quote.service.ts:446-447 / checkout-delivery-address.component.ts:351-352" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="70" y="816" width="580" height="60" as="geometry"/></mxCell><mxCell id="c20" value="Command(command.service.ts:50-135): execute() ごとに ReplaySubject を 1 つ返す" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="720" y="70" width="480" height="900" as="geometry"/></mxCell><mxCell id="c21" value="execute(params): results$ に ReplaySubject、commands$ に params(:126-131)&lt;br&gt;process$ は create 時に購読済み(:120)→ 戻り値を購読しなくても走る" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="110" width="440" height="60" as="geometry"/></mxCell><mxCell id="c22" value="Queue(既定): concatMap(:109-116)&lt;br&gt;前が終わるまで待つ。全部実行&lt;br&gt;例: プロフィール更新、チケット作成・返信" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="190" width="440" height="60" as="geometry"/></mxCell><mxCell id="c23" value="CancelPrevious: switchMap + finalize で complete(:75-93)&lt;br&gt;前の購読を切る。前の fetch は abort。サーバーに届いていれば処理は進む&lt;br&gt;例: 配送先設定、注文確定、カート検証、リアルタイム在庫" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="270" width="440" height="72" as="geometry"/></mxCell><mxCell id="c24" value="ErrorPrevious: switchMap + 前の呼び出し元に Error(&amp;#x27;Canceled by next command&amp;#x27;)(:84-85)&lt;br&gt;本体では未使用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="362" width="440" height="56" as="geometry"/></mxCell><mxCell id="c25" value="Parallel: mergeMap(:97-104)。全部同時&lt;br&gt;本体では未使用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="438" width="440" height="48" as="geometry"/></mxCell><mxCell id="c26" value="エラー: tap(notify) が呼び出し元の ReplaySubject に error を転送(:62-68)&lt;br&gt;catchError(() =&amp;gt; EMPTY) で process$ は生き続ける → 次の execute は普通に動く" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="506" width="440" height="60" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="Command は State に書かない。成功の tap でイベントを dispatch するだけ。&lt;br&gt;State への反映は「更新 API の応答を merge」ではなく「Query がもう一度 GET」= 8.0 規則 2 の Query / Command 版" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="590" width="440" height="72" as="geometry"/></mxCell><mxCell id="c33" value="strategy はクライアント側の順序だけを守る。冪等性はバックエンドの責任。&lt;br&gt;注文確定の CancelPrevious は「2 回目が来たら 1 回目の応答を捨てる」。二重注文はサーバーでカートが消費されることで防がれる(place-order listener が OrderPlacedEvent でカートを捨てる)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="676" width="440" height="90" as="geometry"/></mxCell><mxCell id="c34" value="根拠: command.service.ts:27-38, 50-135 / user-profile.service.ts:31-48 / checkout-delivery-address.service.ts:34-119 / order.service.ts:26-54 / cart-validation.service.ts:27-44 / product-availability.service.ts:33-42 / checkout-place-order-event.listener.ts:24-41 / 利用規模: Query 20、Command 65、CancelPrevious 24、Queue 8(明示)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="780" width="440" height="110" as="geometry"/></mxCell><mxCell id="c35" value="EventService が結ぶ「書く → イベント → 読む側が取り直す」(event.service.ts:68-113, 144-159)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#d79b00;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="1240" y="70" width="540" height="900" as="geometry"/></mxCell><mxCell id="c36" value="実例 1 プロフィール更新(直接配線、reload)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1260" y="104" width="500" height="24" as="geometry"/></mxCell><mxCell id="c37" value="フォーム送信 → UserProfileFacade.update(details)&lt;br&gt;→ updateCommand.execute (Queue)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="134" width="500" height="48" as="geometry"/></mxCell><mxCell id="c38" value="takeUserId(true) → PATCH users/current&lt;br&gt;成功の tap: dispatch(UserAccountChangedEvent)(user-profile.service.ts:36-41)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="196" width="500" height="48" as="geometry"/></mxCell><mxCell id="c39" value="userQuery の reloadOn: [UserAccountChangedEvent](user-account.service.ts:32)&lt;br&gt;→ loading: true(名前は古いまま)→ GET users/current → data 差し替え → async パイプ → 印 → tick" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="258" width="500" height="56" as="geometry"/></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c37" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c38" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="実例 2 配送先設定(リスナ経由、reset)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1260" y="334" width="500" height="24" as="geometry"/></mxCell><mxCell id="c43" value="住所カード選択 → setDeliveryAddress(address)&lt;br&gt;→ setDeliveryAddressCommand.execute (CancelPrevious)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="364" width="500" height="48" as="geometry"/></mxCell><mxCell id="c44" value="checkoutPreconditions()(userId / cartId / ゲスト判定を take(1))→ PUT carts/{id}/addresses/delivery&lt;br&gt;成功の tap: dispatch(CheckoutDeliveryAddressSetEvent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="426" width="500" height="56" as="geometry"/></mxCell><mxCell id="c45" value="リスナが翻訳(checkout-delivery-address-event.listener.ts:109-122)&lt;br&gt;→ CheckoutSupportedDeliveryModesQueryResetEvent + CheckoutQueryResetEvent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="496" width="500" height="48" as="geometry"/></mxCell><mxCell id="c46" value="checkoutQuery$ は 2 種類のイベントしか知らない(checkout-query.service.ts:32-54)&lt;br&gt;→ initialState → 購読者がいるので即 GET carts/{id}?fields=deliveryAddress,deliveryMode,paymentInfo&lt;br&gt;→ 各コンポーネントは loading でスピナー → data で描画" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="558" width="500" height="64" as="geometry"/></mxCell><mxCell id="c47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c43" target="c44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c44" target="c45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c45" target="c46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c50" value="イベントの供給源は 3 つ: ① Command の成功(tap で dispatch) ② NgRx のアクション(StateEventService: LoginEvent ← AuthActions.LOGIN、LanguageSetEvent ← SET_ACTIVE_LANGUAGE) ③ 任意の Observable(LogoutEvent ← isUserLoggedIn の true → false)&lt;br&gt;→ NgRx の世界の出来事を Query が reloadOn / resetOn の 1 行で受けられる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="642" width="500" height="90" as="geometry"/></mxCell><mxCell id="c51" value="バックエンドへの意味: 更新のあとは必ず GET が来る(PATCH の本文は画面に使われない)→ read-after-write 一貫性が前提。&lt;br&gt;「いつ古くなるか」はイベントの一覧として依頼書に書く。書かれていなければフロントは初回購読の 1 回しか取りに来ない。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="746" width="500" height="80" as="geometry"/></mxCell><mxCell id="c52" value="根拠: state-event.service.ts:36-55 / user-auth-event.builder.ts:40-63 / site-context-event.builder.ts:41-72 / checkout-query-event.listener.ts:38-62 / checkout.events.ts:12-31" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1260" y="840" width="500" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="19 zone モードと zoneless の経路の差" id="19 zone モードと zoneless の経路の差"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="zone.js を外すと何が変わり、何が変わらないか。左: zone モードで tick が起きる 2 本の経路。中: zoneless に残る 1 本と Targeted。右: 差分と Spartacus 2612 の現状。20 章" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1740" height="30" as="geometry"/></mxCell><mxCell id="c3" value="zone モード(Spartacus 本体): tick を起こす経路は 2 本、tick は常に Global" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="640" height="850" as="geometry"/></mxCell><mxCell id="c4" value="印を付ける段階(16 章)は両モードで同じ: markViewDirty が 64|1024 を自分→根元(:5967-5978)、markAncestorsForTraversal が 8192、いずれも notify(source)(:18258)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="110" width="580" height="48" as="geometry"/></mxCell><mxCell id="c5" value="経路 A: zone.js が Angular zone のタスクを数える → マイクロタスクが 0 → NgZone.checkStable → onMicrotaskEmpty(17.3)&lt;br&gt;印が付いていなくても発火する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="178" width="580" height="56" as="geometry"/></mxCell><mxCell id="c6" value="NgZoneChangeDetectionScheduler: dirtyFlags |= 1; appRef._tick()(core.mjs:309-321)&lt;br&gt;provideZoneChangeDetection の ENVIRONMENT_INITIALIZER が initialize() を呼ぶ(core.mjs:363-373)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="254" width="580" height="56" as="geometry"/></mxCell><mxCell id="c7" value="経路 B(保険): notify(source) → shouldScheduleTick: Angular zone の中なら false(:18332)→ 経路 A に任せる&lt;br&gt;zone の外(runOutsideAngular、外部ライブラリ)からの印だけ rAF / setTimeout(0) で予約(:18317-18323)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="330" width="580" height="64" as="geometry"/></mxCell><mxCell id="c8" value="tick(): zone モードでは dirtyFlags &amp;amp; 7(1|2|4)なら |= 1(:18345-18347)→ 経路 B の tick も Global" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="414" width="580" height="48" as="geometry"/></mxCell><mxCell id="c9" value="synchronizeOnce: useGlobalCheck &amp;amp;&amp;amp; !zonelessEnabled → mode 0 Global(:12469)&lt;br&gt;Default(16 CheckAlways)の view は印が無くても評価(:5905)、OnPush は 64 でも評価(:5906)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="482" width="580" height="56" as="geometry"/></mxCell><mxCell id="c10" value="時刻: fetch 応答・Promise の続きはマイクロタスクが尽きた「その場」。クリックだけ eventCoalescing で次のフレーム(17.3 の表)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="558" width="580" height="56" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="安定(isStable = PendingTasks が空 :12323-12325): ZoneStablePendingTask が zone のタスク数を PendingTasks に橋渡し(core.mjs:413-445)&lt;br&gt;→ setTimeout / setInterval / 外部 SDK の Promise も SSR を待たせる。i18next の reloadInterval: false はその回避(i18next-http-backend.initializer.ts:66-68)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="634" width="580" height="80" as="geometry"/></mxCell><mxCell id="c18" value="根拠: core.mjs:299-325, 348-412, 413-445 / _debug_node-chunk.mjs:5900-5933, 12396-12401, 12460-12471, 18258-18360 / zone.js 0.16.3 bundles/zone.umd.min.js 約 39 KB / 17 章" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="70" y="734" width="580" height="60" as="geometry"/></mxCell><mxCell id="c19" value="zoneless(Angular 21 の既定): 残る経路は 1 本、tick は常に Targeted" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="720" y="70" width="480" height="850" as="geometry"/></mxCell><mxCell id="c20" value="NgZone の実体は NoopNgZone(:2603-2623): run も runOutsideAngular もただ関数を呼ぶ&lt;br&gt;onMicrotaskEmpty を発火する者がいない → 経路 A は存在しない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="110" width="440" height="64" as="geometry"/></mxCell><mxCell id="c21" value="notify(source) → dirtyFlags(0 → 2 / 1〜5 → 4 / 12 → 16 / 13 → 2 / 他 → 8 :18262-18304)&lt;br&gt;shouldScheduleTick の zone 判定は !zonelessEnabled で短絡 → 印の通知 = 予約" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="194" width="440" height="64" as="geometry"/></mxCell><mxCell id="c22" value="予約 = requestAnimationFrame / setTimeout(0) の早い方(scheduleCallbackWithRafRace :2359-2384)= 次のフレーム&lt;br&gt;tick 直後の続きだけ queueMicrotask(:18229-18257、連続 100 回でエラー 103 :18190)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="278" width="440" height="72" as="geometry"/></mxCell><mxCell id="c23" value="tick(): 1 を立てない。ApplicationRef.tick() も zoneless では立てない(:12397-12399)&lt;br&gt;→ synchronizeOnce は mode 1 Targeted(:12469)。印の無い root view には入らない(:12466)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="370" width="440" height="64" as="geometry"/></mxCell><mxCell id="c24" value="root に 1024 が届けば root の refreshView → 子は Global で辿る(:5816-5817)&lt;br&gt;→ markForCheck / クリック / async パイプの印なら、評価範囲は zone モードと同じ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="454" width="440" height="64" as="geometry"/></mxCell><mxCell id="c25" value="差が出るのは 2 つだけ:&lt;br&gt;① 印がどこにも付かない → tick 自体が起きない(setTimeout / subscribe で普通のフィールドに代入、ngZone.run の中で印なし)&lt;br&gt;② 8192 だけ(signal の set)→ 途中の Default の view は評価しない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="538" width="440" height="84" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="安定: PendingTasks だけ。HttpClient の各リクエスト(_module-chunk.mjs:1456-1460, 1529-1531)、Router の遷移(_router-chunk.mjs:4667-4669)、PendingTasks.run(:2775-2797)、pendingUntilEvent&lt;br&gt;→ タイマーは待たない。HttpClient を通らない非同期は待たれずに HTML が出る" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="642" width="440" height="90" as="geometry"/></mxCell><mxCell id="c32" value="根拠: _effect-chunk2.mjs:2231-2260, 2359-2390, 2603-2623, 2767-2769, 2775-2797 / _debug_node-chunk.mjs:18205-18375, 18392-18414 / core.mjs:723, 2142 / @schematics/angular/application/schema.json:131-135" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="752" width="440" height="80" as="geometry"/></mxCell><mxCell id="c33" value="差分と Spartacus 2612 の現状" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#d79b00;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="1240" y="70" width="540" height="850" as="geometry"/></mxCell><mxCell id="c34" value="既定の決まり方: ZONELESS_ENABLED の工場は true(:2767-2769)。bootstrapApplication は provideZonelessChangeDetectionInternal() を provider の先頭に置く(core.mjs:2142)&lt;br&gt;provideZoneChangeDetection が ZONELESS_ENABLED: false と本物の NgZone で上書き(core.mjs:348-387)&lt;br&gt;→ zone.js を読み込んでいても provider が無ければ zoneless で動く" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="110" width="500" height="90" as="geometry"/></mxCell><mxCell id="c35" value="Spartacus の設定: app.config.ts:30 provideZoneChangeDetection({ eventCoalescing: true })、project.json:23 polyfills zone.js&lt;br&gt;schematics は zoneless: false 固定(generate-default-workspace.ts:33)、docs は --zoneless=false(installation.md:24)&lt;br&gt;移行 221121_7 に「provideZoneChangeDetection を app.module.ts へ移す」専用マイグレーション" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="220" width="500" height="84" as="geometry"/></mxCell><mxCell id="c36" value="集計(spec 除く): @Component 552 ファイル、OnPush 389(約 70%)、Default 約 160&lt;br&gt;Default で subscribe 64(購読直後に代入 26)、setTimeout 17(Default 4)、NgZone 注入 8、markForCheck 48、detectChanges 45" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="324" width="500" height="64" as="geometry"/></mxCell><mxCell id="c37" value="zone に頼る 3 系統: ① Default + 購読内代入(cx-storefront の HostBinding、storefront.component.ts:86-87, 127-129, 194-196)&lt;br&gt;② setTimeout で代入(base-message.component.ts:71 ほか)&lt;br&gt;③ 外部 SDK を ngZone.run で包む(CDC gigya-raas.component.ts:98、SmartEdit :132、OPF global-functions 約 30 箇所)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="408" width="500" height="84" as="geometry"/></mxCell><mxCell id="c38" value="両モードで同じに動くもの: async パイプ(notify(4))、テンプレートのイベント、@Input、signal を読むテンプレート、ViewRef.detectChanges()(1024 + Global :6152-6155)、Query / Command と NgRx の値(async パイプ経由)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="512" width="500" height="64" as="geometry"/></mxCell><mxCell id="c39" value="判断: 本体は zone モード前提で検証済み。顧客側で zoneless に切り替える構成はサポートの外&lt;br&gt;カスタム実装は OnPush + async パイプ / signal で書き、購読内代入や外部コールバックは markForCheck か signal.set で終える。SSR で待たせたい非同期は HttpClient か PendingTasks.run&lt;br&gt;→ zone モードでは「経路 A + 自分の印」、zoneless では「自分の印だけ」で評価され、結果が一致する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="596" width="500" height="100" as="geometry"/></mxCell><mxCell id="c40" value="根拠: projects/storefrontapp/src/app/app.config.ts:30 / project.json:23 / core-libs/schematics/src/shared/utils/generate-default-workspace.ts:33 / migrations.json:93-96 / docs/migration/221121_7/migration.md:331-375 / core-libs/core/src/test.ts:28 / cx-api.service.ts:74 / opf-resource-loader.service.ts:237 / cx-common-engine.ts:20 / grep 集計は 20.7" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1260" y="716" width="500" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="20 状態管理の 2 つの作り方と変更検知の 2 つのモード" id="20 状態管理の 2 つの作り方と変更検知の 2 つのモード"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="「signal か NgRx か」は状態の持ち方の問い、「zone か zoneless か」は描き直しの問い。左: Spartacus 本体の NgRx 経路。中: Angular 21 の signal 経路と 2 つを結ぶ橋。右: 2×2 の軸、本体の集計、カスタム実装での選び方。21 章" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1740" height="30" as="geometry"/></mxCell><mxCell id="c3" value="NgRx + Observable(Spartacus 本体): 1 本の木、書き込みは Action、届け方は async パイプ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="640" height="850" as="geometry"/></mxCell><mxCell id="c4" value="OCC の JSON → Connector / Adapter(Normalizer が API の形を State の形に変える。5.2、15.2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="110" width="580" height="48" as="geometry"/></mxCell><mxCell id="c5" value="Effect: ofType(LOAD_PRODUCT) → bufferDebounceTime で同時の要求をまとめる → productConnector.getMany → LoadProductSuccess / Fail(product.effect.ts:34-57)&lt;br&gt;withdrawOn(contextChange$): 言語・通貨が変わったら途中の取得を捨てる(:55)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="174" width="580" height="70" as="geometry"/></mxCell><mxCell id="c6" value="Reducer: loaderReducer が { loading, error, success, value } を新しいオブジェクトで返す(loader.reducer.ts:39-60)&lt;br&gt;商品詳細は entityScopedLoaderReducer&amp;lt;Product&amp;gt;(...) の 1 行(reducers/index.ts:31)= entities[code][scope] の辞書" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="260" width="580" height="70" as="geometry"/></mxCell><mxCell id="c7" value="Store の木: StateWithProduct { product: { details, search, searchByCode, ... } }(product-state.ts:14, 22-33)。StoreModule.forFeature で枝を足す(product-store.module.ts:35)&lt;br&gt;meta reducer が ssrTransfer.keys の枝だけ TransferState に書く(state/reducers/index.ts:27-43、transfer-state.reducer.ts:18-35)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="346" width="580" height="80" as="geometry"/></mxCell><mxCell id="c8" value="Selector: createSelector の工場(code, scope)→ 引数の組ごとに memoized(product.selectors.ts:19-38)&lt;br&gt;push 型: Store が変わるたびに走り、入力の参照が同じなら前の値(NgRx の仕様)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="442" width="580" height="64" as="geometry"/></mxCell><mxCell id="c9" value="Facade: store.pipe(select(...)) を Observable で返す(product.service.ts:55-59)&lt;br&gt;ProductLoadingService: shouldLoad$(!loading &amp;amp;&amp;amp; !success &amp;amp;&amp;amp; !error)のときだけ dispatch(product-loading.service.ts:102-132)= 取得済みなら取らない。using + shareReplay で購読者が何人でも 1 本(:139-142)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="522" width="580" height="84" as="geometry"/></mxCell><mxCell id="c10" value="コンポーネント: Observable → async パイプ → markForCheck(16.3)。末端で toSignal に替えてもよい(21.6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="622" width="580" height="48" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="書き込みは dispatch(Action)だけ。Action の列がそのまま履歴(Redux DevTools、private.providers.ts:55、非 production)&lt;br&gt;木が 1 本なので「全体のスナップショット」があり、SSR はそれを JSON にできる(cx-state)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="690" width="580" height="64" as="geometry"/></mxCell><mxCell id="c18" value="根拠: core-libs/core/src/product/{facade,services,store}/ / state/utils/loader/loader.reducer.ts / state/reducers/index.ts / state/config/state-config.ts:24-35 / core/package.json:22-24(@ngrx 21.0.1)/ 5 章・15 章・19 章" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="70" y="770" width="580" height="60" as="geometry"/></mxCell><mxCell id="c19" value="Signal(Angular 21): 散らばった入れ物、書き込みは set、届け方は読み取り" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="720" y="70" width="480" height="850" as="geometry"/></mxCell><mxCell id="c20" value="params = signal(...)(_effect-chunk2.mjs:2723-2736)。set / update で書く(_effect-chunk.mjs:365-379)。equal が同値と言えば何も起きない(:369)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="110" width="440" height="60" as="geometry"/></mxCell><mxCell id="c21" value="resource / rxResource / httpResource(_resource-chunk.mjs:101-108、rxjs-interop.mjs:210-257、http.mjs:356-390)&lt;br&gt;effect(loadEffect) が params を読む(:220, 286-320)。前回を AbortController で中断(:297-301)、pendingTasks.add() で SSR を待たせる(:298)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="186" width="440" height="84" as="geometry"/></mxCell><mxCell id="c22" value="loader / stream: HttpClient(または既存の Connector)を呼ぶ。rxResource は Observable を購読して最初の値を Promise にし、abort で unsubscribe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="286" width="440" height="60" as="geometry"/></mxCell><mxCell id="c23" value="state signal に { status, stream } を set(:315-320)。status / value / error / isLoading は computed(:117-119, 227-231)&lt;br&gt;木は無い: resource を作った場所ごとに 1 つ。重複排除・まとめ取りは無し" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="362" width="440" height="72" as="geometry"/></mxCell><mxCell id="c24" value="computed: 読まれたときに依存先の version を確かめて再計算(_effect-chunk.mjs:264-284)。pull 型。読まれなければ一度も計算しない(:288-293)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="450" width="440" height="60" as="geometry"/></mxCell><mxCell id="c25" value="テンプレートで value() と読む → その view の consumer が汚れる(18.3)。async パイプも markForCheck も不要" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="526" width="440" height="48" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="2 つを結ぶ橋: toSignal(Observable → signal。呼んだ瞬間に subscribe、rxjs-interop.mjs:100-160)/ toObservable(signal → Observable。effect 経由なので set の直後には流れない :74-98)&lt;br&gt;本体の signal 利用はすべてこの橋の先: listParams = signal → toObservable → switchMap(facade) → toSignal(subscription-list.component.ts:44-64)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="594" width="440" height="110" as="geometry"/></mxCell><mxCell id="c32" value="根拠: @angular/core 21.2.25 fesm2022/_effect-chunk.mjs:264-298, 340-379 / _effect-chunk2.mjs:2723-2736, 2884-2900 / _resource-chunk.mjs:68-108, 109-332 / rxjs-interop.mjs:74-160, 210-257 / @angular/common http.mjs:349-392" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="720" width="440" height="90" as="geometry"/></mxCell><mxCell id="c33" value="2 本の軸と Spartacus 2612 の現状" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#d79b00;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="1240" y="70" width="540" height="850" as="geometry"/></mxCell><mxCell id="c34" value="2×2(21.1): 縦 = 状態の持ち方、横 = 変更検知のモード&lt;br&gt;NgRx + async × zone = Spartacus 本体 / NgRx + async × zoneless = 動く(notify(4))&lt;br&gt;signal × zone = 動く(zone の tick に乗る)/ signal × zoneless = Angular 21 新規アプリの既定&lt;br&gt;→ 2 つの問いは独立。どちらの印も notify に入り、分岐は shouldScheduleTick(20 章)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="110" width="500" height="96" as="geometry"/></mxCell><mxCell id="c35" value="本体の NgRx: @ngrx/store 21.0.1(core/package.json:22-24)、StoreModule.forFeature 22、store ディレクトリ 23、createEffect 213、createSelector 264、Facade 79&lt;br&gt;SSR 転送の既定は product / cms / site-context / site-theme の 4 枝。@ngrx/signals(SignalStore)は 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="222" width="500" height="84" as="geometry"/></mxCell><mxCell id="c36" value="本体の signal: 13 ファイル。signal( 17、computed( 13、toSignal( 6、effect( 3、toObservable( 1、model( 2&lt;br&gt;resource / rxResource / httpResource / linkedSignal / input( は 0。すべて Facade の外側(コンポーネント・ディレクティブ 12 + インターセプタ 1)。Store・Effect・Selector・Facade の返り値に signal は無い" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="322" width="500" height="84" as="geometry"/></mxCell><mxCell id="c37" value="差が出る所: 重複排除(Store 全体で 1 回 vs resource を作った場所ごと)/ まとめ取り(bufferDebounceTime vs 無し)/ SSR 転送(ssrTransfer vs httpResource の transfer cache のみ)/ 履歴(Action の列 vs 無し)/ 書き込みのコスト(新しい木 vs O(1))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="422" width="500" height="84" as="geometry"/></mxCell><mxCell id="c38" value="選び方(21.8): ① 本体が持つサーバー状態 → Facade + async か toSignal ② 自前のサーバー状態 → 15 章 Facade + 19 章 Query(NgRx の枝は DevTools・ssrTransfer・共有辞書が要るときだけ)③ 画面だけの状態 → signal ④ 画面をまたぐクライアント状態 → root サービスの signal&lt;br&gt;Facade の返り値は Observable のまま。toSignal は末端で 1 回" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="522" width="500" height="100" as="geometry"/></mxCell><mxCell id="c39" value="バックエンドへの意味: API 契約は不変。resource を直接使うと同じ GET が複数回・途中で abort されたリクエストが増える。cx-state に載るのは NgRx の 4 枝だけ(Query・signal・resource は載らない)&lt;br&gt;依頼書には機能ごとに状態の種類 ①〜④ を 1 行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="638" width="500" height="84" as="geometry"/></mxCell><mxCell id="c40" value="根拠: core-libs/core/package.json:22-24 / product-store.module.ts:20-30 / cms-store.module.ts:25 / site-context-store.module.ts:24 / site-theme-store.module.ts:23 / private.providers.ts:55 / subscription-product-price.component.ts:33-51 / http-error-handler.interceptor.ts:46, 91 / docs/spa-bff-reference-implementation.md:1156-1177 / grep 集計は 21.7" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1260" y="738" width="500" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="21 カスタマイズの 7 段と 100 シナリオの分布" id="21 カスタマイズの 7 段と 100 シナリオの分布"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="「〜を変えたい」はどの段で吸収できるか。左ほど安い。各段の件数は 100 シナリオ(22 章)を「いちばん浅く済む段」で数えたもの。段 0 と段 1 で 64 件" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1740" height="30" as="geometry"/></mxCell><mxCell id="c3" value="段 0  バックエンドのデータ・CMS だけ&lt;br&gt;18 件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="220" height="60" as="geometry"/></mxCell><mxCell id="c4" value="フロントは変更なし&lt;br&gt;#12 類似商品の見出し / #26 検索候補の件数 / #27 リストかグリッド / #36 クーポン / #51 マイアカウントのメニュー / #62 コンテンツページ / #68 404 / #71-72 言語・通貨" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="220" height="150" as="geometry"/></mxCell><mxCell id="c5" value="段 1  フロントの設定値&lt;br&gt;46 件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="80" width="220" height="60" as="geometry"/></mxCell><mxCell id="c6" value="provideConfig に 1 ブロック&lt;br&gt;#21 一覧の件数 / #24 無限スクロール / #14・#25 fields / #20 maxAge / #41-44 チェックアウト / #61 商品 URL / #74 文言 / #81-83 レイアウト / #98 ssrTransfer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;verticalAlign=middle;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="290" y="160" width="220" height="150" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="段 2  見た目・アウトレット&lt;br&gt;8 件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="80" width="220" height="60" as="geometry"/></mxCell><mxCell id="c9" value="SCSS・CSS 変数・provideOutlet&lt;br&gt;#1 標準の見た目 / #28 カードへの差し込み / #38 カート行の置き換え / #78 ブランドカラー / #84-85 前後・置き換え / #90 スロットの CSS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;verticalAlign=middle;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="540" y="160" width="220" height="150" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogon