66;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="688" width="100" height="60" as="geometry"/></mxCell><mxCell id="c60" value="users/{userId}/campaignEntries/{code}(例)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="806" y="688" width="280" height="60" as="geometry"/></mxCell><mxCell id="c61" value="新 ItemType" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1092" y="688" width="170" height="60" as="geometry"/></mxCell><mxCell id="c62" value="新コントローラ + WsDTO(8.4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1268" y="688" width="170" height="60" as="geometry"/></mxCell><mxCell id="c63" value="campaignCode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1444" y="688" width="160" height="60" as="geometry"/></mxCell><mxCell id="c64" value="ItemType 名は SAP Commerce 標準型システムの一般知識で、本リポジトリでは検証不能(Backoffice の型検索で確認)。URL パターンは Spartacus の default-occ-*-config.ts 45 ファイルから収集。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="758" width="900" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="12 cms/pages 応答 → async パイプまでの 8 段階" id="12 cms/pages 応答 → async パイプまでの 8 段階"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="cms/pages の応答が届いてから、コンポーネントの data$ | async が値を出すまでの 8 段階(左)と、段階ごとに何が起きるか・失敗したときの範囲(右)。14 章" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="30" as="geometry"/></mxCell><mxCell id="c3" value="A. 8 段階: 何をするか(上から順に実行される)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="680" height="1010" as="geometry"/></mxCell><mxCell id="c4" value="1. 正規化&lt;br&gt;OccCmsPageNormalizer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="164" width="250" height="96" as="geometry"/></mxCell><mxCell id="c5" value="1 つの JSON から 2 つの形を作る&lt;br&gt;・page.slots[位置].components = {uid, typeCode, flexType, properties}&lt;br&gt;・components = コンポーネント本体(properties は捨てる)&lt;br&gt;flexType = typeCode(CMSFlexComponent だけ flexType 属性)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="164" width="390" height="96" as="geometry"/></mxCell><mxCell id="c6" value="2. ストア格納&lt;br&gt;PageEffects → reducer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="250" height="96" as="geometry"/></mxCell><mxCell id="c7" value="CmsGetComponentFromPage(同梱全件)と LoadCmsPageDataSuccess を一度に dispatch&lt;br&gt;components[uid].pageContext[&amp;#x27;ContentPage&amp;#x27;] = success&lt;br&gt;ページ index[pageId] = success → ガードが待っていた hasPage が通る" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="270" width="390" height="96" as="geometry"/></mxCell><mxCell id="c8" value="3. ガード(まだ描画しない)&lt;br&gt;CmsPageGuardService.canActivatePage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="376" width="250" height="96" as="geometry"/></mxCell><mxCell id="c9" value="ページ内の flexType 集合 → determineMappings(遅延モジュールの import())&lt;br&gt;→ guards 実行 → i18n チャンク読込 → childRoutes があれば再ナビゲーション&lt;br&gt;→ true で Router が PageLayoutComponent を生成、ROUTER_NAVIGATED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="376" width="390" height="96" as="geometry"/></mxCell><mxCell id="c10" value="4. レイアウト → スロット&lt;br&gt;PageLayoutComponent / PageSlotComponent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="482" width="250" height="96" as="geometry"/></mxCell><mxCell id="c11" value="LayoutConfig.layoutSlots[template].slots ∩ 応答の slots → &amp;lt;cx-page-slot&amp;gt; を並べる&lt;br&gt;各スロットが getContentSlot(position) で components 配列を取る&lt;br&gt;pending = 件数 → cx-pending クラス" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="482" width="390" height="96" as="geometry"/></mxCell><mxCell id="c12" value="5. 遅延判定とアウトレット&lt;br&gt;OutletDirective + DeferLoaderService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="588" width="250" height="96" as="geometry"/></mxCell><mxCell id="c13" value="cxOutletDefer: INSTANT なら即、DEFER なら IntersectionObserver で画面に入るまで&lt;br&gt;ラッパーすら作らない(既定は INSTANT)&lt;br&gt;cxOutlet=flexType に差し替えテンプレートがあればそちらを描く(1.7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="588" width="390" height="96" as="geometry"/></mxCell><mxCell id="c14" value="6. ラッパーが createComponent&lt;br&gt;ComponentWrapperDirective" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="694" width="250" height="96" as="geometry"/></mxCell><mxCell id="c15" value="getMapping(flexType) → 無ければ何もしない(dev 警告のみ)&lt;br&gt;子 Injector に CmsComponentData{uid, data$} と mapping.providers を provide&lt;br&gt;→ ViewContainerRef.createComponent → constructor で注入 → ComponentCreateEvent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="694" width="390" height="96" as="geometry"/></mxCell><mxCell id="c16" value="7. data$ を購読(ここで初めて動く)&lt;br&gt;CmsService.getComponentData" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="250" height="96" as="geometry"/></mxCell><mxCell id="c17" value="ストアに uid × context があれば同期で値 → HTTP なし&lt;br&gt;無ければ LoadCmsComponent → 同一マクロタスク分をまとめて&lt;br&gt;GET cms/components?componentIds=…(50 件/回、商品ページなら productCode=)&lt;br&gt;ナビゲーションの子項目も同じ getList を通る(別エフェクト)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="800" width="390" height="96" as="geometry"/></mxCell><mxCell id="c18" value="8. async パイプ → 変更検知 → 描画&lt;br&gt;Angular AsyncPipe(pure: false)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="906" width="250" height="96" as="geometry"/></mxCell><mxCell id="c19" value="最初の transform で subscribe(= 7 が動く)。同期で来ればその場で値&lt;br&gt;値が来るたび markForCheck → OnPush を次の変更検知で再描画&lt;br&gt;無い間は null → *ngIf が描かない。(loaded) で pending-- → cx-pending 解除" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="906" width="390" height="96" as="geometry"/></mxCell><mxCell id="c20" value="B. 段階ごとに何が起きるか: 通信 / ストア / DOM / 失敗の範囲" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#d79b00;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="760" y="70" width="1070" height="1010" as="geometry"/></mxCell><mxCell id="c21" value="段階" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="110" width="110" height="44" as="geometry"/></mxCell><mxCell id="c22" value="OCC への通信" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="110" width="160" height="44" as="geometry"/></mxCell><mxCell id="c23" value="静的ファイル" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1070" y="110" width="120" height="44" as="geometry"/></mxCell><mxCell id="c24" value="NgRx ストア" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="110" width="200" height="44" as="geometry"/></mxCell><mxCell id="c25" value="DOM / 変更検知" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1410" y="110" width="190" height="44" as="geometry"/></mxCell><mxCell id="c26" value="失敗したときの範囲" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1610" y="110" width="200" height="44" as="geometry"/></mxCell><mxCell id="c27" value="1 正規化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="164" width="110" height="96" as="geometry"/></mxCell><mxCell id="c28" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="164" width="160" height="96" as="geometry"/></mxCell><mxCell id="c29" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1070" y="164" width="120" height="96" as="geometry"/></mxCell><mxCell id="c30" value="まだ触らない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="164" width="200" height="96" as="geometry"/></mxCell><mxCell id="c31" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1410" y="164" width="190" height="96" as="geometry"/></mxCell><mxCell id="c32" value="応答が壊れていれば&lt;br&gt;LoadCmsPageDataFail → 404 ページ" style=