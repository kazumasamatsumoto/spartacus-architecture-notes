="110" height="96" as="geometry"/></mxCell><mxCell id="c40" value="なし&lt;br&gt;(guards の実装次第)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="376" width="160" height="96" as="geometry"/></mxCell><mxCell id="c41" value="遅延モジュールの JS&lt;br&gt;翻訳 JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1070" y="376" width="120" height="96" as="geometry"/></mxCell><mxCell id="c42" value="読むだけ&lt;br&gt;(flexType の集合)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="376" width="200" height="96" as="geometry"/></mxCell><mxCell id="c43" value="なし&lt;br&gt;(ルート設定の差し替えあり)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1410" y="376" width="190" height="96" as="geometry"/></mxCell><mxCell id="c44" value="ページ全体: 遷移中止&lt;br&gt;(guards false / import 失敗)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1610" y="376" width="200" height="96" as="geometry"/></mxCell><mxCell id="c45" value="4 レイアウト→スロット" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="482" width="110" height="96" as="geometry"/></mxCell><mxCell id="c46" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="482" width="160" height="96" as="geometry"/></mxCell><mxCell id="c47" value="なし" style=