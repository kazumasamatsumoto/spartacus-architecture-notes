as="geometry"/></mxCell><mxCell id="c68" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1464" y="664" width="140" height="50" as="geometry"/></mxCell><mxCell id="c69" value="B2B 組織" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="720" width="170" height="50" as="geometry"/></mxCell><mxCell id="c70" value="NgRx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="836" y="720" width="150" height="50" as="geometry"/></mxCell><mxCell id="c71" value="userId + 各 ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="992" y="720" width="190" height="50" as="geometry"/></mxCell><mxCell id="c72" value="更新アクションで該当エンティティ再読込" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1188" y="720" width="270" height="50" as="geometry"/></mxCell><mxCell id="c73" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1464" y="720" width="140" height="50" as="geometry"/></mxCell><mxCell id="c74" value="URL の階層(users/{userId}/carts/{cartId}/...)が、そのままフロントで必要な ID の数になる(10.4)。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="780" width="940" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="09 アプリケーションのライフサイクル" id="09 アプリケーションのライフサイクル"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Spartacus アプリのライフサイクル: index.html 取得 → 起動 → 初期化 → ゲート → 描画 → 実行中イベント → SSR → 永続化(12 章)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="c3" value="A. 9 フェーズ: 何が起きるか" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="700" height="900" as="geometry"/></mxCell><mxCell id="c4" value="0. HTML 取得" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="170" height="78" as="geometry"/></mxCell><mxCell id="c5" value="index.html は &amp;lt;app-root&amp;gt; だけ(CSR)。meta occ-backend-base-url でビルド後に接続先を差し替え可能" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="110" width="490" height="78" as="geometry"/></mxCell><mxCell id="c6" value="1. 起動と DI 構築&lt;br&gt;main.ts:17" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="198" width="170" height="78" as="geometry"/></mxCell><mxCell id="c7" value="bootstrapApplication(AppComponent, appConfig)→ importProvidersFrom(AppModule)→ Config を deepMerge で合成。イベントビルダー(Navigation / Login・Logout / LanguageSet)が登録される" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="198" width="490" height="78" as="geometry"/></mxCell><mxCell id="c8" value="2. APP_INITIALIZER(23 個)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="286" width="170" height="78" as="geometry"/></mxCell><mxCell id="c9" value="並列に走る。順序保証が無いので各自が configInit.getStable(scope) を待つ。サイトコンテキストは URL &amp;gt; localStorage &amp;gt; config 既定。&amp;#x27;**&amp;#x27; ルート追加、i18next 初期化、MODULE_INITIALIZER(カート ID 復元)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="286" width="490" height="78" as="geometry"/></mxCell><mxCell id="c10" value="3. ゲート&lt;br&gt;LOCATION_INITIALIZED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="374" width="170" height="78" as="geometry"/></mxCell><mxCell id="c11" value="Promise.all(LOCATION_INITIALIZED_MULTI): ① Config が stable ② 認証(localStorage のトークン復元 → OAuth コールバック判定)→ userId = current / anonymous。通過後に Router の初回ナビゲーション" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="374" width="490" height="78" as="geometry"/></mxCell><mxCell id="c12" value="4. ルーティング → 描画&lt;br&gt;(3 章)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="462" width="170" height="78" as="geometry"/></mxCell><mxCell id="c13" value="NavigationStart で URL(/site/lang/curr/...)からサイトコンテキスト確定 → CmsPageGuard → cms/pages → PageLayout → スロット → NavigationEnd(スクロール復元・SEO)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="462" width="490" height="78" as="geometry"/></mxCell><mxCell id="c14" value="5. コンポーネント" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="550" width="170" height="78" as="geometry"/></mxCell><mxCell id="c15" value="ComponentWrapperDirective.ngOnInit → 遅延ロード判定 → createComponent(Injector に CmsComponentData)→ ComponentCreateEvent → ngOnInit / data$ | async(OnPush)→ 遷移で ngOnDestroy → ComponentDestroyEvent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="550" width="490" height="78" as="geometry"/></mxCell><mxCell id="c16" value="6. 実行中のイベント" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="638" width="170" height="78" as="geometry"/></mxCell><mxCell id="c17" value="ページ遷移 / 言語・通貨変更 / ログイン / ログアウト / 401 / HTTP エラー / 遅延ロード。それぞれ「何を捨てて何を取り直すか」が決まっている(右表)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="638" width="490" height="78" as="geometry"/></mxCell><mxCell id="c18" value="7. SSR の場合&lt;br&gt;(デモは CSR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="726" width="170" height="78" as="geometry"/></mxCell><mxCell id="c19" value="OptimizedSsrEngine: timeout 3 秒で CSR にフォールバック、concurrency 10、cache 既定 off。サーバで 1〜5 を実行し TransferState(cms / product / siteContext / siteTheme)を HTML へ。ブラウザは再取得なし + hydration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="726" width="490" height="78" as="geometry"/></mxCell><mxCell id="c20" value="8. 永続化と終了" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="814" width="170" height="78" as="geometry"/></mxCell><mxCell id="c21" value="明示的な終了処理は無い。StatePersistenceService が実行中ずっと localStorage へ書き、次回起動の 2〜3 で復元(トークン / カート ID / 言語 / 通貨 / 同意 / テーマ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="814" width="490" height="78" as="geometry"/></mxCell><mxCell id="c22" value="B. フェーズごとの OCC 呼び出し / localStorage / ストアの破棄 / イベント" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#d79b00;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="780" y="70" width="840" height="900" as="geometry"/></mxCell><mxCell id="c23" value="フェーズ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="110" width="90" height="44" as="geometry"/></mxCell><mxCell id="c24" value="OCC 呼び出し" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="896" y="110" width="250" height="44" as="geometry"/></mxCell><mxCell id="c25" value="localStorage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1152" y="110" width="1