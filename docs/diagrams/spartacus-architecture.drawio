le;" vertex="1" parent="1"><mxGeometry x="1060" y="345" width="420" height="60" as="geometry"/></mxCell><mxCell id="c42" value="弁⑭  100 件ずつに分割(OCC 上限)&lt;br&gt;occ-product-search.adapter.ts:73-99" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1060" y="430" width="420" height="50" as="geometry"/></mxCell><mxCell id="c43" value="HTTP GET products/search?filters=code:a,b,c&amp;amp;pageSize=100&amp;amp;fields=..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1060" y="505" width="420" height="50" as="geometry"/></mxCell><mxCell id="c44" value="弁⑮  同一商品の複数スコープは fields を結合して 1 URL に&lt;br&gt;(products/{code})  occ-requests-optimizer.service.ts:34-75" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1060" y="590" width="420" height="60" as="geometry"/></mxCell><mxCell id="c45" value="弁⑯  SSR 時: cms / product / siteContext / siteTheme を&lt;br&gt;TransferState で転送し、ブラウザは再取得しない(デモは CSR)&lt;br&gt;transfer-state.reducer.ts:16-95" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1060" y="680" width="420" height="70" as="geometry"/></mxCell><mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c38" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c47" value="いいえ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c39" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c40" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c41" target="c42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c42" target="c43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c51" value="実測(2026-10-23 デモ, CSR): ホーム = cms/pages 1 + cms/components 2 + products/search 1 + サイト情報 4 + cart 1。PDP への SPA 遷移 = 6 本、サイト情報/カートは再取得なし。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="905" width="1460" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="08 リソースごとの呼び出し方法の違い" id="08 リソースごとの呼び出し方法の違い"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="フロント側の呼び出し: 通信層は共通、状態層は 2 方式、リソース固有なのは「文脈」と「捨てる条件」(10 章)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="c3" value="A. 3 層に分けると、何が共通で何が違うか" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="560" height="760" as="geometry"/></mxCell><mxCell id="c4" value="通信層&lt;br&gt;Connector → Adapter →&lt;br&gt;Converter → HttpClient" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="190" height="150" as="geometry"/></mxCell><mxCell id="c5" value="全リソース共通。URL は buildUrl(OCC アダプタ 75 中 74)、変換は pipeable(59)、lang / curr と Bearer はインターセプタが自動付与。違うのは設定値(URL テンプレート、Normalizer)だけ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="260" y="110" width="330" height="150" as="geometry"/></mxCell><mxCell id="c6" value="状態層&lt;br&gt;Facade の中身" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="272" width="190" height="150" as="geometry"/></mxCell><mxCell id="c7" value="2 方式のどちらか(機能ライブラリごとに固定)。NgRx: CMS・商品・サイト・カート本体・注文履歴・ユーザー配下・店舗・B2B 組織。Query / Command: ユーザー本体・チェックアウト・注文確定・見積・チケット・カート検証・在庫。SAP ガイド「既存に合わせよ」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="260" y="272" width="330" height="150" as="geometry"/></mxCell><mxCell id="c8" value="文脈と捨てる条件&lt;br&gt;Facade の設計" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="434" width="190" height="150" as="geometry"/></mxCell><mxCell id="c9" value="リソースごとに違う。必要な ID(userId / cartId / PageContext / scope)、前提条件、再読込・破棄のきっかけ、バッチ化。右の表がその一覧" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="260" y="434" width="330" height="150" as="geometry"/></mxCell><mxCell id="c10" value="コンポーネントから見た形" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="596" width="190" height="150" as="geometry"/></mxCell><mxCell id="c11" value="どのリソースでも facade.get() が Observable&amp;lt;T&amp;gt; を返す。違いは Facade の内側だけ。カスタムリソースで決めるのは「方式」「文脈」「捨てる条件」「更新系」の 4 問(10.5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="260" y="596" width="330" height="150" as="geometry"/></mxCell><mxCell id="c12" value="混在の例: 注文(履歴 = NgRx / 確定 = Command)、カート(本体 = NgRx / 検証 = Query)、商品(本体 = NgRx / 在庫 = Query)。境界はリソースではなく「機能ライブラリが書かれた時期」。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="520" height="60" as="geometry"/></mxCell><mxCell id="c13" value="B. リソースごとの文脈 / 捨てる条件 / バッチ(色: 灰 = サイト共通、青 = ユーザー固有、橙 = カート配下)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#d79b00;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="640" y="70" width="980" height="760" as="geometry"/></mxCell><mxCell id="c14" value="リソース" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="110" width="170" height="44" as="geometry"/></mxCell><mxCell id="c15" value="方式" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="836" y="110" width="150" heigh