okeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1360" y="1080" width="250" height="44" as="geometry"/></mxCell><mxCell id="c80" value="文脈の色: 灰 = サイト共通(lang / curr のみ)、青 = ユーザー固有(users/{userId})、橙 = カート配下(+ cartId)。URL の階層がそのままフロントで必要な ID の数になる(10.4)。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="1134" width="1540" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="09 アプリケーションのライフサイクル" id="09 アプリケーションのライフサイクル"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Spartacus アプリのライフサイクル: index.html 取得 → 起動 → 初期化 → 初回ナビゲーション → 描画 → 実行中イベント → 永続化(12 章)。右列はその段階で飛ぶ OCC 呼び出し" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="c3" value="フェーズ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="170" height="30" as="geometry"/></mxCell><mxCell id="c4" value="ブラウザ / Angular / Spartacus で起きること(左→右の順)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="70" width="950" height="30" as="geometry"/></mxCell><mxCell id="c5" value="OCC 呼び出し / 永続化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1220" y="70" width="380" height="30" as="geometry"/></mxCell><mxCell id="c6" value="0. HTML 取得" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="170" height="70" as="geometry"/></mxCell><mxCell id="c7" value="index.html: &amp;lt;app-root&amp;gt;Loading...&amp;lt;/app-root&amp;gt; と meta occ-backend-base-url / media-backend-base-url&lt;br&gt;(CSR なら中身は空。SSR なら描画済み HTML + &amp;lt;script id=cx-state&amp;gt;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="950" height="70" as="geometry"/></mxCell><mxCell id="c8" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="110" width="380" height="70" as="geometry"/></mxCell><mxCell id="c9" value="1. 起動と DI 構築&lt;br&gt;main.ts:17" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="196" width="170" height="90" as="geometry"/></mxCell><mxCell id="c10" value="bootstrapApplication(AppComponent, appConfig)&lt;br&gt;appConfig = provideHttpClient / provideClientHydration / importProvidersFrom(AppModule)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="196" width="460" height="90" as="geometry"/></mxCell><mxCell id="c11" value="DI グラフ構築: provideConfig / provideDefaultConfig の配列 → deepMerge → Config(1.4)&lt;br&gt;イベントビルダー(NavigationEvent, LoginEvent/LogoutEvent, LanguageSetEvent)が登録される" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="196" width="470" height="90" as="geometry"/></mxCell><mxCell id="c12" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="196" width="380" height="90" as="geometry"/></mxCell><mxCell id="c13" value="2. APP_INITIALIZER&lt;br&gt;(23 個、並列。多くは&lt;br&gt;configInit.getStable() を待つ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="302" width="170" height="150" as="geometry"/></mxCell><mxCell id="c14" value="ConfigInitializer&lt;br&gt;CONFIG_INITIALIZER の&lt;br&gt;scope が全部解決 → stable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="302" width="180" height="150" as="geometry"/></mxCell><mxCell id="c15" value="サイトコンテキスト&lt;br&gt;language / currency / baseSite:&lt;br&gt;URL セグメント &amp;gt; localStorage &amp;gt; config 既定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="440" y="302" width="230" height="150" as="geometry"/></mxCell><mxCell id="c16" value="ルーティング&lt;br&gt;ConfigurableRoutes 初期化、外部ルート、&lt;br&gt;&amp;#x27;**&amp;#x27; ルート追加(CmsPageGuard)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="302" width="220" height="150" as="geometry"/></mxCell><mxCell id="c17" value="i18next 初期化&lt;br&gt;fallbackLang / backend(chunk ロード)&lt;br&gt;言語変更に追従" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="910" y="302" width="160" height="150" as="geometry"/></mxCell><mxCell id="c18" value="その他&lt;br&gt;テーマ / アウトレット登録 / SEO / スキップリンク&lt;br&gt;MODULE_INITIALIZER(カート ID 復元など)/ ASM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1080" y="302" width="150" height="150" as="geometry"/></mxCell><mxCell id="c19" value="GET languages&lt;br&gt;GET currencies&lt;br&gt;GET basesites&lt;br&gt;(context が stable になった後)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="302" width="380" height="150" as="geometry"/></mxCell><mxCell id="c20" value="3. 初回ナビゲーション前の&lt;br&gt;ゲート(LOCATION_INITIALIZED)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="468" width="170" height="110" as="geometry"/></mxCell><mxCell id="c21" value="locationInitializedFactory = Promise.all(LOCATION_INITIALIZED_MULTI)&lt;br&gt;① Config が stable  ② 認証: AuthStatePersistence.initSync(localStorage のトークン復元)→ checkOAuthParamsInUrl(OAuth コールバック / 保存トークン)&lt;br&gt;→ userId = current(トークンあり)または anonymous  ③ 通過後に Router の初回ナビゲーション(initialNavigation: enabledBlocking)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="468" width="950" height="110" as="geometry"/></mxCell><mxCell id="c22" value="トークンがあれば&lt;br&gt;以降の users/current/... が有効" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="468" width="380" height="110" as="geometry"/></mxCell><mxCell id="c23" value="4. ルーティング → 描画&lt;br&gt;(3 章)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="594" width="170" height="110" as="geometry"/></mxCell><mxCell id="c24" value="NavigationStart → SiteContextRoutesHandler が URL(/electronics-spa/en/USD/...)から site / lang / curr を確定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="594" width="300" height="110" as="geometry"/></mxCell><mxCell id="c25" value="CmsPageGuard → CmsService.getPage → cms/pages(既定で毎回。loadStrategy=ONCE なら初回のみ)→ PageLayoutComponent → LayoutConfig.layoutSlots → &amp;lt;cx-page-slot&amp;gt; × N" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="594" width="330" height="110" as="geometry"/></mxCell><mxCell id="c26" value="NavigationEnd → OnNavigateService(スクロール復元)&lt;br&gt;SeoMetaService(title / meta)&lt;br&gt;NavigationEvent / PageEvent 発火" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="594" width="290" height="110" as="geometry"/></mxCell><mxCell id="c27" value="GET users/{anonymous|current}/cms/pages?...&lt;br&gt;GET cms/components?componentIds=...(不足分)&lt;br&gt;カート ID が復元されていれば GET users/{id}/carts/{cartId}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="594" width="380" height="110" as="geometry"/></mxCell><mxCell id="c28" value="5. コンポーネントの&lt;br&gt;ライフサイクル" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="720" width="170" height="130" as="geometry"/></mxCell><mxCell id="c29" value="ComponentWrapperDirective.ngOnInit&lt;br&gt;→ determineMappings(flexType)&lt;br&gt;→ featureModules に属すなら遅延ロード" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="720" width="230" height="130" as="geometry"/></mxCell><mxCell id="c30" value="ComponentHandler → createComponent&lt;br&gt;(Injector に CmsComponentData{uid, data$})&lt;br&gt;→ ComponentCreateEvent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="490" y="720" width="230" height="130" as="geometry"/></mxCell><mxCell id="c31" value="Angular フック: constructor → ngOnInit&lt;br&gt;→ data$ | async(OnPush)→ ngOnDestroy&lt;br&gt;cxOutletDefer: ビューポート外は生成を遅延" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="730" y="720" width="240" height="130" as="geometry"/></mxCell><mxCell id="c32" value="ngOnDestroy → ComponentDestroyEvent&lt;br&gt;(遷移で前ページのコンポーネントは破棄)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="980" y="720" width="210" height="130" as="geometry"/></mxCell><mxCell id="c33" value="業務データは Facade 経由&lt;br&gt;GET products/{code}, products/search 等&lt;br&gt;(11 章の文脈 / 捨てる条件に従う)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="720" width="380" height="130" as="geometry"/></mxCell><mxCell id="c34" value="6. 実行中のイベント" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="866" width="170" height="220" as="geometry"/></mxCell><mxCell id="c35" value="ページ遷移&lt;br&gt;RoutingService.go → 4 へ戻る&lt;br&gt;cms/pages は既定で毎回、それ以外はストア済みなら HTTP なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="866" width="180" height="220" as="geometry"/></mxCell><mxCell id="c36" value="言語 / 通貨変更&lt;br&gt;SET_ACTIVE → LANGUAGE_CHANGE&lt;br&gt;→ CMS / 商品ストア全破棄&lt;br&gt;→ LanguageSetEvent(Query 再読込)&lt;br&gt;→ URL を replaceState&lt;br&gt;(トグルで location.reload)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="440" y="866" width="190" height="220" as="geometry"/></mxCell><mxCell id="c37" value="ログイン&lt;br&gt;OAuth password flow →&lt;br&gt;userId = current → AuthActions.Login&lt;br&gt;→ LoginEvent: CMS 破棄 /&lt;br&gt;カート loadOrMerge(匿名カート併合)&lt;br&gt;/ Query resetOn → redirect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="866" width="200" height="220" as="geometry"/></mxCell><mxCell id="c38" value="ログアウト&lt;br&gt;cxRoute logout → coreLogout:&lt;br&gt;userId = anonymous → トークン失効&lt;br&gt;→ AuthActions.Logout → LogoutEvent:&lt;br&gt;CMS / ユーザーストア破棄、カート index リセット" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="850" y="866" width="200" height="220" as="geometry"/></mxCell><mxCell id="c39" value="401 / HTTP エラー&lt;br&gt;AuthHttpHeaderService: refresh または logout&lt;br&gt;HttpErrorInterceptor → 状態別ハンドラ&lt;br&gt;→ GlobalMessage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1060" y="866" width="170" height="220" as="geometry"/></mxCell><mxCell id="c40" value="遷移: cms/pages(既定で毎回)、コンポーネント・商品はストア済みなら無し&lt;br&gt;言語変更: cms/pages 再取得 + lang=xx&lt;br&gt;ログイン: POST authorizationserver/oauth/token、&lt;br&gt;  carts 併合、users/current&lt;br&gt;ログアウト: POST revoke" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="866" width="380" height="220" as="geometry"/></mxCell><mxCell id="c41" value="7. SSR の場合&lt;br&gt;(デモは CSR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1102" width="170" height="110" as="geometry"/></mxCell><mxCell id="c42" value="server.ts: NgExpressEngineDecorator(OptimizedSsrEngine)&lt;br&gt;timeout 3 秒で CSR シェルにフォールバック / concurrency 10 / cache 既定 off / reuseCurrentRendering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="1102" width="470" height="110" as="geometry"/></mxCell><mxCell id="c43" value="サーバで 1〜5 を実行(OAuth コールバックは skip)→ HTML + TransferState(cms / product / siteContext / siteTheme)&lt;br&gt;→ ブラウザは 1〜3 を再実行、ストアは転送状態で初期化され再取得なし、hydration(event replay)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="730" y="1102" width="470" height="110" as="geometry"/></mxCell><mxCell id="c44" value="サーバ側で同じ OCC 呼び出し&lt;br&gt;ブラウザ側はゼロで開始" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="1102" width="380" height="110" as="geometry"/></mxCell><mxCell id="c45" value="8. 永続化と終了" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1228" width="170" height="80" as="geometry"/></mxCell><mxCell id="c46" value="SPA なので明示的な終了処理はない(タブを閉じる)。StatePersistenceService.syncWithStorage が実行中ずっと localStorage に書く&lt;br&gt;→ 次回起動の 2〜3 で復元: 認証トークン / カート ID / 言語 / 通貨 / 匿名同意 / ASM / テーマ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="1228" width="950" height="80" as="geometry"/></mxCell><mxCell id="c47" value="localStorage キー: spartacus + 区切り文字 + {site} + 区切り文字 + auth / cart / language / currency …&lt;br&gt;(state-persistence.service.ts:128-130)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="1228" width="380" height="80" as="geometry"/></mxCell><mxCell id="c48" value="ゲートの意味: フェーズ 3 を通るまで Router は動かないので、フェーズ 4 以降のコードは「Config は確定済み、userId は確定済み、サイトコンテキストは URL から確定済み」を前提にできる。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="1324" width="1540" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="10 呼び出しの 4 階層と毎回・初回" id="10 呼び出しの 4 階層と毎回・初回"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="OCC 呼び出しの 4 階層(左)と、デモサイトで実測した「毎回」と「初回」の違い(右)。13 章" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="c3" value="A. 呼び出しの 4 階層: いつ飛ぶか / いつまで使い回すか" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="640" height="760" as="geometry"/></mxCell><mxCell id="c4" value="1. セッション単位&lt;br&gt;basesites / languages / currencies&lt;br&gt;トークンがあれば users/current、カート ID があれば carts/{id}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="290" height="160" as="geometry"/></mxCell><mxCell id="c5" value="アプリ起動時に 1 回(12 章フェーズ 2〜4)&lt;br&gt;タブを閉じるまで使い回す。ログイン / ログアウトでユーザーとカートだけ取り直し" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="360" y="110" width="300" height="160" as="geometry"/></mxCell><mxCell id="c6" value="2. ページ単位&lt;br&gt;cms/pages(ページ構造 + 同梱コンポーネント)&lt;br&gt;+ 同梱されなかった分の cms/components" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="290" height="160" as="geometry"/></mxCell><mxCell id="c7" value="cms/pages は既定で毎回(routing.loadStrategy = ALWAYS)&lt;br&gt;cms/components は初回のみ(同梱 or ストア済みなら飛ばない)&lt;br&gt;言語変更 / ログイン / ログアウトで全部捨てる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="360" y="290" width="300" height="160" as="geometry"/></mxCell><mxCell id="c8" value="3. コンポーネント単位(追加リソース)&lt;br&gt;ページに置かれたコンポーネントの型で決まる&lt;br&gt;商品カルーセル → products/search、商品詳細 → products/{code}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="290" height="160" as="geometry"/></mxCell><mxCell id="c9" value="コンポーネント生成時(ビューポート外なら遅延)&lt;br&gt;初回のみ。捨てる条件はリソースごと(11 章): 商品は言語・通貨変更まで&lt;br&gt;例外: コンポーネントが自分で捨てる設計(商品参照は毎回)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="360" y="470" width="300" height="160" as="geometry"/></mxCell><mxCell id="c10" value="4. アクション単位&lt;br&gt;カート追加 POST carts/{id}/entries、配送先設定、注文確定、ログイン" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="290" height="160" as="geometry"/></mxCell><mxCell id="c11" value="ユーザー操作のたび(更新系なので使い回しは無い)&lt;br&gt;代わりに「成功後に何を取り直すか」が決まっている&lt;br&gt;(カートは全体を再取得、チェックアウトは単一 Query を再読込)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="360" y="650" width="300" height="160" as="geometry"/></mxCell><mxCell id="c12" value="B. 実測(2026-10-23, CSR, 匿名): 同じ画面に戻ったとき何が飛ぶか  GET/HEAD のみ(OPTIONS 除く)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#d79b00;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="720" y="70" width="900" height="760" as="geometry"/></mxCell><mxCell id="c13" value="リソース" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="110" width="250" height="44" as="geometry"/></mxCell><mxCell id="c14" value="① ホーム初回&lt;br&gt;(ブラウザ起動)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="996" y="110" width="120" height="44" as="geometry"/></mxCell><mxCell id="c15" value="② 商品詳細へ&lt;