ometry x="836" y="440" width="150" height="50" as="geometry"/></mxCell><mxCell id="c46" value="userId + cartId + 前提条件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="992" y="440" width="190" height="50" as="geometry"/></mxCell><mxCell id="c47" value="更新 Command の成功イベント → 単一 Query を Reload / Reset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1188" y="440" width="270" height="50" as="geometry"/></mxCell><mxCell id="c48" value="なし(1 Query に集約)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1464" y="440" width="140" height="50" as="geometry"/></mxCell><mxCell id="c49" value="注文" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="496" width="170" height="50" as="geometry"/></mxCell><mxCell id="c50" value="混在(履歴 NgRx / 確定 Command)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="836" y="496" width="150" height="50" as="geometry"/></mxCell><mxCell id="c51" value="userId(履歴は loggedIn)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="992" y="496" width="190" height="50" as="geometry"/></mxCell><mxCell id="c52" value="履歴・詳細は明示 Clear。確定は CancelPrevious + OrderPlacedEvent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1188" y="496" width="270" height="50" as="geometry"/></mxCell><mxCell id="c53" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1464" y="496" width="140" height="50" as="geometry"/></mxCell><mxCell id="c54" value="ユーザー本体・プロフィール" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="552" width="170" height="50" as="geometry"/></mxCell><mxCell id="c55" value="Query / Command" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="836" y="552" width="150" height="50" as="geometry"/></mxCell><mxCell id="c56" value="userId(loggedIn、匿名なら例外)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="992" y="552" width="190" height="50" as="geometry"/></mxCell><mxCell id="c57" value="UserAccountChangedEvent で再読込 / Login・Logout で破棄 / 言語依存は LanguageSetEvent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1188" y="552" width="270" height="50" as="geometry"/></mxCell><mxCell id="c58" value="なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1464" y="552" width="140" height="50" as="geometry"/></mxCell><mxCell id="c59" value="ユーザー配下(住所・支払・同意・クーポン)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="608" width="170" height="50" as="geometry"/></mxCell><mxCell id="c60" value="NgRx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;stroke