d="c35" value="Facade 経由" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;dashed=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="02 レイヤ構成" id="02 レイヤ構成"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Spartacus のパッケージ / レイヤ構成と依存方向" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="800" height="30" as="geometry"/></mxCell><mxCell id="c3" value="利用者の Angular アプリ(ng add @spartacus/schematics が生成)&lt;br&gt;main.ts → bootstrapApplication(AppComponent) → importProvidersFrom(AppModule)&lt;br&gt;app/spartacus/ spartacus.module.ts / spartacus-features.module.ts(機能モジュール列挙・カスタムコンポーネントを追加)/ spartacus-configuration.module.ts(provideConfig: OCC baseUrl, context, layoutSlots, cmsComponents 上書き)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="1000" height="90" as="geometry"/></mxCell><mxCell id="c4" value="機能ライブラリ feature-libs/* (@spartacus/cart, user, checkout, order, storefinder …)&lt;br&gt;各ライブラリは root(常時ロード・軽量: facade 抽象 + featureModules 宣言)/ core(facade 実装・connector・store)/ occ(adapter・endpoints)/ components(UI + cmsComponents マッピング)の 4 エントリ。本体は typeCode 出現時に遅延ロード" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="1000" height="90" as="geometry"/></mxCell><mxCell id="c5" value="@spartacus/storefront (core-libs/storefront)&lt;br&gt;CMS エンジン: PageLayoutComponent / PageSlotComponent / ComponentWrapperDirective / ComponentHandler / CmsInjectorService / CmsComponentData / Outlet&lt;br&gt;LayoutConfig(layoutSlots)・標準 CMS コンポーネント(Banner, Paragraph, Link, ProductCarousel, Navigation …)・BaseStorefrontModule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="1000" height="90" as="geometry"/></mxCell><mxCell id="c6" value="@spartacus/core (core-libs/core)&lt;br&gt;モデル(CmsComponent 派生)・設定 DI(provideConfig / Config / deepMerge)・NgRx(StateModule, cms/product/site-context ストア, Entity Loader)・Facade(CmsService, ProductService)&lt;br&gt;Connector / Adapter / Converter(Normalizer)・OccEndpointsService(baseUrl + prefix + ${baseSiteId})・Routing(ConfigurableRoutes, CmsPageGuard 用 PageContext)・i18n(i18next)・LazyLoading" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="1000" height="90" as="geometry"/></mxCell><mxCell id="c7" value="OCC v2 REST API (/occ/v2/{baseSiteId}/...)&lt;br&gt;cms/pages, cms/components, products, users/{userId}/carts, basesites, languages, currencies …  + カスタム拡張エンドポイント" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="550" width="1000" height="90" as="geometry"/></mxCell><mxCell id="c8" value="SAP Commerce Cloud (Java / Spring)&lt;br&gt;commercewebservices(OCC Controller + WsDTO + DataMapper/fields)・cmsocc / cmsfacades(CMS ページ・コンポーネントのレンダリング)・facades / services / DAO・ItemType(*-items.xml)・Content Catalog(Staged/Online)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="670" width="1000" height="90" as="geometry"/></mxCell><mxCell id="c9" value="依存 / 呼び出し" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="依存 / 呼び出し" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="依存 / 呼び出し" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="依存 / 呼び出し" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="依存 / 呼び出し" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="ポイント: cmsComponents マッピングの型 (CmsConfig) は core、動的生成とレイアウトは storefront。機能ライブラリの UI は typeCode 単位で遅延ロード。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="1000" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="03 カスタムコンポーネントのデータ経路" id="03 カスタムコンポーネントのデータ経路"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="カスタム CMS コンポーネントが受け取る 2 種類のデータ経路(A: CMS 属性 / B: 業務データ)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c3" value="フロントエンド(Angular / Spartacus)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1060" height="900" as="geometry"/></mxCell><mxCell id="c4" value="バックエンド(SAP Commerce Cloud / Java)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#d79b00;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="1160" y="70" width="560" height="900" as="geometry"/></mxCell><mxCell id="c5" value="MyPromoComponent (Angular, standalone, OnPush)&lt;br&gt;cmsComponents: { MyPromoBannerComponent: { component: MyPromoComponent } }&lt;br&gt;inject(CmsComponentData).data$   /   inject(MyPromoFacade).get(id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="110" width="980" height="80" as="geometry"/></mxCell><mxCell id="c6" value="経路 A: CMS 属性(バックオフィスで編集する内容)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#009900;" vertex="1" parent="1"><mxGeometry x="80" y="220" width="460" height="24" as="geometry"/></mxCell><mxCell id="c7" value="CmsComponentData&amp;lt;CmsMyPromoBannerComponent&amp;gt;&lt;br&gt;{ uid, data$ }  (cms-injector.service.ts:28-49)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="250" width="460" height="60" as="geometry"/></mxCell><mxCell id="c8" value="CmsService.getComponentData(uid)&lt;br&gt;→ NgRx cms.components[uid] (取得済みなら API なし)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="340" width="460" height="60" as="geometry"/></mxCell><mxCell id="c9" value="OccCmsPageNormalizer / OccCmsComponentAdapter&lt;br&gt;cms/pages 同梱 or cms/components?componentIds= バッチ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="430" width="460" height="60" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="経路 B: 業務データ(動的・商品/ユーザー/在庫など)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="580" y="220" width="480" height="24" as="geometry"/></mxCell><mxCell id="c14" value="Facade (抽象, root エントリ)  MyPromoFacade&lt;br&gt;facadeFactory で遅延実装へプロキシ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="250" width="480" height="60" as="geometry"/></mxCell><mxCell id="c15" value="Facade 実装 (core)  MyPromoService&lt;br&gt;Query / NgRx Store: loading・success・error をキャッシュ&lt;br&gt;同一キーは再取得しない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="340" width="480" height="70" as="geometry"/></mxCell><mxCell id="c16" value="Connector (core)  MyPromoConnector&lt;br&gt;機能向け API。Adapter に委譲" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="440" width="480" height="60" as="geometry"/></mxCell><mxCell id="c17" value="Adapter 抽象 (core) MyPromoAdapter  ←  OCC 実装 (occ) OccMyPromoAdapter&lt;br&gt;OccEndpointsService.buildUrl(&amp;#x27;myPromo&amp;#x27;, {urlParams, queryParams})&lt;br&gt;converter.pipeable(MY_PROMO_NORMALIZER)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="530" width="480" height="80" as="geometry"/></mxCell><mxCell id="c18" value="Converter / Normalizer (occ)&lt;br&gt;Occ DTO (JSON) → FE モデル MyPromo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="640" width="480" height="60" as="geometry"/></mxCell><mxCell id="c19" value="endpoints 設定(occ)&lt;br&gt;provideDefaultConfig({ backend: { occ: { endpoints: {&lt;br&gt;  myPromo: &amp;#x27;users/${userId}/my-promos/${promoId}?fields=DEFAULT&amp;#x27; }}}})" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="560" width="460" height="80" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="レスポンス変換" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;dashed=1;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="URL 組み立て" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="cmsocc + cmsfacades&lt;br&gt;GET cms/pages / cms/components&lt;br&gt;ItemType の属性を自動でレンダリング(文字列化)&lt;br&gt;→ コントローラ追加は不要" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1190" y="770" width="500" height="90" as="geometry"/></mxCell><mxCell id="c27" value="*-items.xml&lt;br&gt;MyPromoBannerComponent extends SimpleCMSComponent&lt;br&gt;属性: headline, content, promoId(参照のみ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1190" y="640" width="500" height="70" as="geometry"/></mxCell><mxCell id="c28" value="カスタム OCC Controller (commercewebservices 拡張)&lt;br&gt;@Controller @RequestMapping(&amp;quot;/{baseSiteId}/users/{userId}/my-promos&amp;quot;)&lt;br&gt;@GetMapping(&amp;quot;/{promoId}&amp;quot;) → MyPromoWsDTO (fields 対応)&lt;br&gt;単位 = リソース(コンポーネントではない)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1190" y="110" width="500" height="100" as="geometry"/></mxCell><mxCell id="c29" value="Facade → Service → DAO / 外部 API&lt;br&gt;MyPromoFacade.getPromo(promoId) → MyPromoData → DataMapper → WsDTO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1190" y="240" width="500" height="70" as="geometry"/></mxCell><mxCell id="c30" value="HTTP GET (lang / curr はインターセプタが付与)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="62" y="460"/><mxPoint x="62" y="880"/><mxPoint x="1440" y="880"/></Array></mxGeometry></mxCell><mxCell id="c31" value="属性を読む" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;dashed=1;" edge="1" parent="1" source="c27" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="HTTP GET&lt;br&gt;(認証/lang/curr 自動付与)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1125" y="570"/><mxPoint x="1125" y="160"/></Array></mxGeometry></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="設計ルール: CMS 属性には「参照(ID/コード)と表示設定」だけを持たせ、実体データは経路 B のリソース API で返す。&lt;br&gt;リスト系は codes=a,b,c のような一括取得エンドポイントにして、FE 側で bufferDebounceTime によるバッチ化ができる形にする。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="905" width="980" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="04 バックエンド判断フロー" id="04 バックエンド判断フロー"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="バックエンド担当者向け: カスタムコンポーネントで「何を・どの単位で」返すかの判断" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c3" value="そのデータは CMS 管理者が&lt;br&gt;バックオフィスで編集する内容か?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="80" width="320" height="70" as="geometry"/></mxCell><mxCell id="c4" value="YES → ItemType の属性にする&lt;br&gt;・*-items.xml に属性追加(文字列/HTML/メディア/参照コード)&lt;br&gt;・cms/pages に自動同梱される(コントローラ不要)&lt;br&gt;・FE は CmsComponentData.data$ で受け取る&lt;br&gt;・依頼書: typeCode, 属性名/型/例, 配置先スロット" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="420" height="110" as="geometry"/></mxCell><mxCell id="c5" value="NO(動的データ)→ 既存 OCC API で取れるか?&lt;br&gt;(products, categories, users/{id}/carts, orders …)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="200" width="420" height="70" as="geometry"/></mxCell><mxCell id="c6" value="YES → コントローラ追加不要&lt;br&gt;・CMS 属性には code / ID だけ持たせる&lt;br&gt;・FE が既存 Facade(ProductService 等)で取得&lt;br&gt;(例: ProductCarouselComponent.productCodes → products/search?filters=code:...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="320" width="420" height="100" as="geometry"/></mxCell><mxCell id="c7" value="NO → 既存リソースの拡張で足りるか?&lt;br&gt;(Product/Order 等の DTO に属性追加)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="460" width="420" height="70" as="geometry"/></mxCell><mxCell id="c8" value="YES → 既存 WsDTO / Populator を拡張&lt;br&gt;・fields=... で返す属性を制御&lt;br&gt;・FE は Occ モデル拡張 + Normalizer で受ける" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="570" width="420" height="90" as="geometry"/></mxCell><mxCell id="c9" value="NO → 新しい OCC エンドポイント(リソース単位)&lt;br&gt;・@Controller + @RequestMapping(&amp;quot;/{baseSiteId}/...&amp;quot;)&lt;br&gt;・URL はコンポーネント名ではなく資源名(名詞・複数形)&lt;br&gt;・単件 GET /{id} と一括 GET ?ids=a,b,c の両方&lt;br&gt;・WsDTO + DataMapper、fields パラメータ対応、lang/curr 前提&lt;br&gt;・FE: Facade/Connector/Adapter/Normalizer/Store を新設" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="700" width="420" height="130" as="geometry"/></mxCell><mxCell id="c10" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="足りない" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;dashed=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="足りない" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;dashed=1;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="アンチパターン: コンポーネントごとに専用 API を作る(/myPromoBannerComponentData)。再利用できず、バッチ化もできない。&lt;br&gt;単位は「ドメインのリソース」。CMS コンポーネントは「どのリソースを、どう見せるか」の設定だけを持つ。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="860" width="1000" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="05 JSP→ヘッドレス 責務の移行" id="05 JSP→ヘッドレス 責務の移行"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="JSP(アクセラレータ)の CMS コンポーネントコントローラが持っていた責務は、ヘッドレスではどこへ行くか" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c3" value="JSP 時代: 1 コンポーネント = 1 コントローラ + 1 JSP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="420" height="760" as="geometry"/></mxCell><mxCell id="c4" value="XxxComponentController extends AbstractCMSComponentController&lt;br&gt;fillModel(request, model, component)&lt;br&gt;→ return &amp;quot;cms/xxxComponent.jsp&amp;quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="380" height="80" as="geometry"/></mxCell><mxCell id="c5" value="(a) component.getXxx() を Model へ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="380" height="70" as="geometry"/></mxCell><mxCell id="c6" value="(b) 派生データの計算&lt;br&gt;(商品引き当て・ナビツリー展開・在庫・判定)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="315" width="380" height="70" as="geometry"/></mxCell><mxCell id="c7" value="(c) URL 生成 (c:url / 商品 URL / メディア URL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="410" width="380" height="70" as="geometry"/></mxCell><mxCell id="c8" value="(d) HTML 描画 (JSP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="505" width="380" height="70" as="geometry"/></mxCell><mxCell id="c9" value="(e) &amp;lt;cms:component&amp;gt; 子コンポーネント include" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="380" height="70" as="geometry"/></mxCell><mxCell id="c10" value="(f) フォーム POST 処理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="695" width="380" height="70" as="geometry"/></mxCell><mxCell id="c11" value="ヘッドレス: JSON は cms/pages が一律に返し、描画は Angular" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="540" y="70" width="1120" height="760" as="geometry"/></mxCell><mxCell id="c12" value="自動: ItemType 属性が cms/pages / cms/components の JSON に出る&lt;br&gt;(コントローラ不要)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="220" width="500" height="70" as="geometry"/></mxCell><mxCell id="c13" value="B-1 フロントが資源 API で再計算&lt;br&gt;例: productCodes → products/search?filters=code:..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="315" width="500" height="60" as="geometry"/></mxCell><mxCell id="c14" value="B-2 バックエンドが構造化データを JSON に埋め込む&lt;br&gt;例: navigationNode ツリー(葉は itemId の参照)&lt;br&gt;→ 構造は埋め込み、実体は参照。全ユーザー共通・小さいものだけ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1110" y="290" width="530" height="80" as="geometry"/></mxCell><mxCell id="c15" value="B-3 新しい資源 API(8 章)&lt;br&gt;ユーザー固有 / 大きい / 他画面でも使う / 高頻度更新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1110" y="390" width="530" height="60" as="geometry"/></mxCell><mxCell id="c16" value="フロントで生成: cxRoute + RoutingConfig、media.baseUrl 前置&lt;br&gt;バックエンドは code / label / 相対メディアパスだけ返す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="410" width="500" height="60" as="geometry"/></mxCell><mxCell id="c17" value="Angular コンポーネントのテンプレート&lt;br&gt;(リッチテキストだけは HTML 文字列を属性で返し innerHTML 表示)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="505" width="500" height="60" as="geometry"/></mxCell><mxCell id="c18" value="スロット構造 / composition.inner / entries 参照" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="600" width="500" height="60" as="geometry"/></mxCell><mxCell id="c19" value="REST POST エンドポイント + フロントの CommandService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="695" width="500" height="60" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c5" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c6" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="255"/><mxPoint x="520" y="330"/><mxPoint x="1095" y="330"/></Array></mxGeometry></mxCell><mxCell id="c23" value="足りない" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c7" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c8" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c9" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c10" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="禁止: HTML 断片で済ませる / ストアフロント絶対 URL を返す / コンポーネント専用エンドポイント / ユーザー固有データを CMS JSON に埋め込む / Model 名のままの JSON キー" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="850" width="1600" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></