geometry"/></mxCell><mxCell id="c32" value="③ フロント: fields に項目を足す、cmsComponents を登録、エンドポイントを足す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="610" width="520" height="50" as="geometry"/></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c30" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c31" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="順番を逆にすると: fields に WsDTO に無い項目 → HTTP 400 Incorrect field(デモ実測)→ 商品の画面ごと出ない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="680" width="520" height="60" as="geometry"/></mxCell><mxCell id="c36" value="根拠: デモ products/1934793?fields=code,noSuchField → 400 / core/occ/adapters/product/default-occ-product-config.ts:14-26 / core/occ/utils/occ-user-ids.ts:7-9" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1220" y="760" width="520" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="24 ビュー層の Java の行き先と責務の分け方" id="24 ビュー層の Java の行き先と責務の分け方"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="JSP やタグの裏で動いていた Java は、ヘッドレスでは呼ばれない。左: アクセラレータの 1 つの Web アプリ。中: ヘッドレスで残る通り道と、各処理の行き先。右: フロントとバックを決める 6 つの問い。25 章" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1740" height="30" as="geometry"/></mxCell><mxCell id="c3" value="アクセラレータ(JSP): 1 つの Web アプリで完結" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="520" height="720" as="geometry"/></mxCell><mxCell id="c4" value="ページコントローラ(addon / storefront の web/src)&lt;br&gt;@RequireHardLogIn・@PreValidateCheckoutStep&lt;br&gt;model.addAttribute(&amp;quot;opfPaymentMethods&amp;quot;, facade...)  ← 緑の Facade を呼ぶ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="480" height="80" as="geometry"/></mxCell><mxCell id="c5" value="BeforeViewHandler / Validator(web/src)&lt;br&gt;ビュー名の差し替え、metaRobots、パンくず、入力チェック" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="480" height="60" as="geometry"/></mxCell><mxCell id="c6" value="JSP / タグ / EL 関数&lt;br&gt;${x.displayName}・spring:theme・fn:escapeXml&lt;br&gt;ycommerce:sanitizeHTML・&amp;lt;script&amp;gt; の直書き" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="480" height="80" as="geometry"/></mxCell><mxCell id="c7" value="Facade / Service(core・facades 拡張)&lt;br&gt;OPFAcceleratorFacade.getActiveConfigurations()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="480" height="60" a