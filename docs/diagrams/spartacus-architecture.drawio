ource="c29" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="Q6 画面の一時的な状態か(開閉・選択中・入力途中)→ フロント" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1220" y="510" width="520" height="60" as="geometry"/></mxCell><mxCell id="c34" value="いいえ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;endArrow=block;endFill=1;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="c31" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="両方に置くもの: ログイン要求・入力チェック・数量の上限・外部サービスの証明&lt;br&gt;正はバック、フロントは写し(規則は依頼書でもらう)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="600" width="520" height="70" as="geometry"/></mxCell><mxCell id="c36" value="✕ バックが「残り 3 点」や HTML 断片を返す / フロントが合計を計算し直す / フロントだけで権限を確かめる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1220" y="690" width="520" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>